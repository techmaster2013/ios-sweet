index 0000000..9274c50
--- /dev/null
+++ b/bsd/dev/sweet_xhci.c
@@ -0,0 +1,1683 @@
+/*
+ * SWEET (Raspberry Pi 5) USB keyboard and mouse.
+ *
+ * The Pi 5 USB ports are on RP1, behind the PCIe x4 link the firmware brings
+ * up (config.txt pciex4_reset=0 keeps it, with RP1's BAR at CPU 0x1f00000000).
+ * RP1 has two DWC3 controllers in xHCI host mode (ADT /sweet-xhci reg). This
+ * driver resets each one, then from one polling thread (no interrupts):
+ *
+ *   - enumerates devices on the root ports (no hubs yet), also on hotplug;
+ *   - for every HID boot interface (keyboard, mouse) switches it to the boot
+ *     protocol and keeps one interrupt-IN transfer queued;
+ *   - turns reports into iPadOS HID events (iokit/Kernel/arm/hid/SweetHID.cpp):
+ *     keyboard usages to SweetHIDKeyboard, mouse motion/buttons/wheel to
+ *     SweetHIDPointer. Esc and F1 are the Home button, F2 the side (lock) button.
+ *
+ * DMA memory is one physically contiguous cacheable allocation; every
+ * structure is cleaned+invalidated (dsync) right after the CPU writes it and
+ * before the CPU reads what the controller wrote, so it works whether or not
+ * the PCIe path is coherent. RP1 sees host memory at PA + dma-offset
+ * (0x10_0000_0000 on the Pi 5).
+ * Boot-args: xhci=0 disables the driver, xhcidebug=1 logs every report.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <kern/locks.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/sockio.h>
+#include <net/if.h>
+#include <net/if_types.h>
+#include <net/ethernet.h>
+#include <net/if_ether.h>
+#include <net/ether_if_module.h>
+#include <net/kpi_interface.h>
+#include <net/if_media.h>
+#include <net/dlil.h>
+#include <sys/kern_event.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+/* iokit/Kernel/arm/SweetNet.cpp: IOKit objects configd looks for */
+extern void sweet_net_register(const char *prefix, unsigned unit, const unsigned char mac[6], const char *model);
+extern void sweet_net_link(int up);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern void IOSleep(unsigned milliseconds);
+/* iokit/Kernel/arm/hid/SweetHID.cpp */
+extern void sweet_hid_kbd(unsigned page, unsigned usage, int down);
+extern void sweet_hid_pointer(int dx, int dy, unsigned buttons, int wheel, int hwheel);
+extern void sweet_hid_key(int key, int down);
+
+/* Capability registers */
+#define CAP_LENGTH      0x00
+#define CAP_HCSPARAMS1  0x04
+#define CAP_HCSPARAMS2  0x08
+#define CAP_HCCPARAMS1  0x10
+#define CAP_DBOFF       0x14
+#define CAP_RTSOFF      0x18
+/* Operational registers */
+#define OP_USBCMD       0x00
+#define OP_USBSTS       0x04
+#define OP_PAGESIZE     0x08
+#define OP_CRCR         0x18
+#define OP_DCBAAP       0x30
+#define OP_CONFIG       0x38
+#define OP_PORTSC(n)    (0x400 + 0x10 * ((n) - 1))
+#define CMD_RS          (1u << 0)
+#define CMD_HCRST       (1u << 1)
+#define STS_HCH         (1u << 0)
+#define STS_CNR         (1u << 11)
+/* PORTSC */
+#define PS_CCS          (1u << 0)
+#define PS_PED          (1u << 1)
+#define PS_PR           (1u << 4)
+#define PS_PP           (1u << 9)
+#define PS_CSC          (1u << 17)
+#define PS_PRC          (1u << 21)
+#define PS_CHANGES      (0x7fu << 17)
+#define PS_KEEP         ((1u << 0) | (1u << 3) | (0xfu << 10) | (1u << 24) | (1u << 30) | \
+	                 (0xfu << 5) | (1u << 9) | (3u << 14) | (7u << 25))
+/* Interrupter 0 (runtime base + 0x20) */
+#define IR_IMAN         0x20
+#define IR_ERSTSZ       0x28
+#define IR_ERSTBA       0x30
+#define IR_ERDP         0x38
+/* DWC3 global control */
+#define DWC3_GCTL       0xc110
+
+/* TRB types */
+#define TRB_NORMAL      1
+#define TRB_SETUP       2
+#define TRB_DATA        3
+#define TRB_STATUS      4
+#define TRB_LINK        6
+#define TRB_ENABLE_SLOT 9
+#define TRB_DISABLE_SLOT 10
+#define TRB_ADDRESS_DEV 11
+#define TRB_CONFIG_EP   12
+#define TRB_EVAL_CTX    13
+#define TRB_EV_TRANSFER 32
+#define TRB_EV_CMD      33
+#define TRB_EV_PORT     34
+#define TRB_C           (1u << 0)
+#define TRB_TC          (1u << 1)       /* link: toggle cycle */
+#define TRB_ISP         (1u << 2)
+#define TRB_IOC         (1u << 5)
+#define TRB_IDT         (1u << 6)
+#define TRB_TYPE(t)     ((uint32_t)(t) << 10)
+#define CC_SUCCESS      1
+#define CC_SHORT        13
+
+struct trb {
+	uint32_t p0, p1, status, ctrl;
+};
+
+#define MAX_HC          2
+#define MAX_DEV         4               /* per controller */
+#define MAX_HID         2               /* HID interfaces per device */
+#define CMD_TRBS        64
+#define EVT_TRBS        256
+#define EP0_TRBS        64
+#define INT_TRBS        32
+
+/* DMA layout (offsets in the per-controller allocation) */
+#define D_DCBAA         0x0000          /* 256 x u64 */
+#define D_ERST          0x0800
+#define D_CMD           0x1000
+#define D_EVT           0x2000
+#define D_SPARR         0x3000          /* scratchpad pointer array (<= 256) */
+#define D_DEV(d)        (0x4000 + (d) * 0x4000)
+#define DEV_SIZE        0x4000
+#define DV_IN           0x0000          /* input context (<= 33 x 64) */
+#define DV_OUT          0x1000          /* device context (32 x 64) */
+#define DV_EP0          0x1800
+#define DV_INT(i)       (0x1c00 + (i) * 0x200)
+#define DV_BUF          0x2000          /* control transfer data, 1 KiB */
+#define DV_REP(i)       (0x2400 + (i) * 0x40)
+#define DV_RXB          0x2800          /* iPhone USB Ethernet receive buffer, 2 KiB */
+#define ETH_RXB         0x800
+#define DV_TXB          0x3000          /* ... and transmit buffer, 2 KiB */
+#define D_SP            (D_DEV(MAX_DEV))        /* scratchpad pages */
+
+struct ring {
+	struct trb *t;
+	uint64_t dma;
+	uint32_t n, enq;
+	uint32_t pcs;
+};
+
+/*
+ * Mouse report layout from its HID report descriptor (report protocol), so
+ * the wheel works: boot protocol only guarantees buttons + X/Y (3 bytes).
+ * Offsets are in bits from the first byte after the report ID (if any).
+ */
+struct field {
+	uint16_t off;
+	uint8_t size;                   /* 0: absent */
+};
+
+struct mouse_layout {
+	bool valid, ids;                /* ids: reports start with a report ID byte */
+	uint8_t rid;                    /* the report ID carrying X/Y */
+	struct field btn, x, y, wheel, pan;
+	uint8_t nbtn;
+};
+
+struct hid_if {
+	bool used;
+	uint8_t iface, proto;           /* 1 keyboard, 2 mouse */
+	uint8_t ep, dci;
+	uint16_t mps;
+	uint16_t rdesc_len;             /* from the HID class descriptor */
+	struct ring ring;
+	uint8_t *rep;
+	uint64_t rep_dma;
+	uint8_t last[8];
+	struct mouse_layout ml;
+};
+
+struct dev {
+	bool used;
+	uint8_t slot, port, speed;
+	uint8_t *base;
+	uint64_t base_dma;
+	struct ring ep0;
+	struct hid_if hid[MAX_HID];
+	/* iPhone USB tethering (Apple USB Ethernet, Linux "ipheth"): step 1, probe + receive. */
+	struct {
+		bool on;
+		uint8_t iface, alt, in_dci, out_dci;
+		uint16_t in_mps, out_mps;
+		struct ring in, out;
+		uint8_t *rx;
+		uint64_t rx_dma;
+		uint8_t *tx;
+		uint64_t tx_dma;
+		uint32_t frames;
+		uint8_t mac[6];
+	} eth;
+};
+
+struct hc {
+	vm_offset_t regs, op, rt, db;
+	uint8_t *dma;
+	uint64_t dma_pa, dma_size;
+	uint32_t ports, slots, ctxsz, sp;
+	struct ring cmd;
+	struct trb *evt;
+	uint64_t evt_dma;
+	uint32_t evt_deq, ccs;
+	/* completions the waiters look for */
+	bool cmd_done;
+	uint32_t cmd_cc, cmd_slot;
+	bool xfer_done;
+	uint32_t xfer_cc, xfer_slot, xfer_rem;
+	bool rescan;
+	struct dev dev[MAX_DEV];
+	int idx;
+};
+
+static struct hc hcs[MAX_HC];
+static int nhc;
+static uint64_t dma_off;
+static uint32_t xdebug;
+static int scroll_mult = 1;     /* boot-arg xhciscroll=N (negative inverts) */
+
+static inline uint32_t
+rd32(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+wr32(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+static inline void
+wr64(vm_offset_t base, uint32_t off, uint64_t v)
+{
+	wr32(base, off, (uint32_t)v);
+	wr32(base, off + 4, (uint32_t)(v >> 32));
+}
+
+static inline uint64_t
+dma_of(struct hc *h, const void *p)
+{
+	return h->dma_pa + (uint64_t)((const uint8_t *)p - h->dma) + dma_off;
+}
+
+/* Clean+invalidate a DMA structure (CPU writes out, stale lines dropped). */
+static void
+dsync(struct hc *h, const void *p, size_t len)
+{
+	flush_dcache64((addr64_t)(h->dma_pa + (uint64_t)((const uint8_t *)p - h->dma)), (unsigned)len, TRUE);
+}
+
+static void
+ring_init(struct hc *h, struct ring *r, void *mem, uint32_t n)
+{
+	r->t = mem;
+	r->n = n;
+	r->enq = 0;
+	r->pcs = 1;
+	r->dma = dma_of(h, mem);
+	bzero(mem, n * sizeof(struct trb));
+	struct trb *link = &r->t[n - 1];
+	link->p0 = (uint32_t)r->dma;
+	link->p1 = (uint32_t)(r->dma >> 32);
+	link->ctrl = TRB_TYPE(TRB_LINK) | TRB_TC;       /* cycle 0: not yet owned */
+	dsync(h, mem, n * sizeof(struct trb));
+}
+
+/* Queue one TRB; returns its DMA address. */
+static uint64_t
+ring_put(struct hc *h, struct ring *r, uint32_t p0, uint32_t p1, uint32_t status, uint32_t ctrl)
+{
+	struct trb *t = &r->t[r->enq];
+	uint64_t at = r->dma + (uint64_t)r->enq * sizeof(struct trb);
+	t->p0 = p0;
+	t->p1 = p1;
+	t->status = status;
+	__builtin_arm_dmb(0xb);
+	t->ctrl = (ctrl & ~TRB_C) | r->pcs;
+	dsync(h, t, sizeof(*t));
+	if (++r->enq == r->n - 1) {
+		struct trb *link = &r->t[r->n - 1];
+		__builtin_arm_dmb(0xb);
+		link->ctrl = (link->ctrl & ~TRB_C) | r->pcs;
+		dsync(h, link, sizeof(*link));
+		r->pcs ^= 1;
+		r->enq = 0;
+	}
+	return at;
+}
+
+static void
+doorbell(struct hc *h, uint32_t slot, uint32_t target)
+{
+	__builtin_arm_dsb(0xf);
+	wr32(h->db, 4 * slot, target);
+}
+
+static struct dev *
+dev_by_slot(struct hc *h, uint32_t slot)
+{
+	for (int i = 0; i < MAX_DEV; i++) {
+		if (h->dev[i].used && h->dev[i].slot == slot) {
+			return &h->dev[i];
+		}
+	}
+	return NULL;
+}
+
+static void hid_report(struct hc *h, struct dev *d, struct hid_if *hi, uint32_t len);
+static void eth_rx(struct hc *h, struct dev *d, uint32_t len);
+static void en_tx_done(void);
+static void en_detach_dev(struct dev *d);
+
+/*
+ * Minimal HID report descriptor parser: finds the input fields of a mouse
+ * (Generic Desktop X, Y, Wheel; Consumer AC Pan; Button page) in the report
+ * that carries X. Handles report IDs, usage lists and usage ranges.
+ */
+static void
+parse_mouse(const uint8_t *rd, uint32_t len, struct mouse_layout *ml)
+{
+	uint32_t page = 0, rsize = 0, rcount = 0, rid = 0;
+	uint32_t usages[16], nus = 0, umin = 0, umax = 0;
+	bool range = false;
+	uint16_t pos[16] = { 0 };       /* input bit position per report ID (low 4 bits) */
+	struct {
+		uint8_t rid;
+		struct field f;
+	} btn = { 0, { 0, 0 } }, x = btn, y = btn, wh = btn, pan = btn;
+	uint8_t nbtn = 0;
+
+	bzero(ml, sizeof(*ml));
+	for (uint32_t i = 0; i < len;) {
+		uint8_t b = rd[i];
+		if (b == 0xfe) {                /* long item */
+			if (i + 2 >= len) {
+				break;
+			}
+			i += 3 + rd[i + 1];
+			continue;
+		}
+		uint32_t sz = (b & 3) == 3 ? 4 : (b & 3), v = 0;
+		if (i + 1 + sz > len) {
+			break;
+		}
+		for (uint32_t k = 0; k < sz; k++) {
+			v |= (uint32_t)rd[i + 1 + k] << (8 * k);
+		}
+		i += 1 + sz;
+		switch (b & 0xfc) {
+		case 0x04: page = v; break;                     /* Usage Page */
+		case 0x74: rsize = v; break;                    /* Report Size */
+		case 0x94: rcount = v; break;                   /* Report Count */
+		case 0x84: rid = v; ml->ids = true; break;      /* Report ID */
+		case 0x08:                                      /* Usage */
+			if (nus < 16) {
+				usages[nus++] = sz == 4 ? v : (page << 16 | v);
+			}
+			break;
+		case 0x18: umin = sz == 4 ? v : (page << 16 | v); range = true; break;
+		case 0x28: umax = sz == 4 ? v : (page << 16 | v); range = true; break;
+		case 0x80: {                                    /* Input */
+			uint16_t *p = &pos[rid & 15];
+			if (!(v & 1) && (v & 2)) {              /* data, variable */
+				for (uint32_t f = 0; f < rcount && rsize && rsize <= 32; f++) {
+					uint32_t u = f < nus ? usages[f] :
+					    range ? MIN(umin + f, umax) : (nus ? usages[nus - 1] : 0);
+					struct field fl = { (uint16_t)(*p + f * rsize), (uint8_t)rsize };
+					if (u == 0x10030 && !x.f.size) {
+						x.rid = (uint8_t)rid; x.f = fl;
+					} else if (u == 0x10031 && !y.f.size) {
+						y.rid = (uint8_t)rid; y.f = fl;
+					} else if (u == 0x10038 && !wh.f.size) {
+						wh.rid = (uint8_t)rid; wh.f = fl;
+					} else if (u == 0xc0238 && !pan.f.size) {
+						pan.rid = (uint8_t)rid; pan.f = fl;
+					} else if (u == 0x90001 && !btn.f.size && rsize == 1) {
+						btn.rid = (uint8_t)rid; btn.f = fl;
+						nbtn = (uint8_t)MIN(rcount - f, 8u);
+					}
+				}
+			}
+			*p = (uint16_t)(*p + rsize * rcount);
+		}
+		/* FALLTHROUGH: main items clear the local usages */
+		case 0x90: case 0xb0: case 0xa0: case 0xc0:
+			nus = 0;
+			range = false;
+			break;
+		default:
+			break;
+		}
+	}
+	if (!x.f.size || !y.f.size || x.rid != y.rid) {
+		return;
+	}
+	ml->rid = x.rid;
+	ml->x = x.f;
+	ml->y = y.f;
+	if (btn.f.size && btn.rid == x.rid) {
+		ml->btn = btn.f;
+		ml->nbtn = nbtn;
+	}
+	if (wh.f.size && wh.rid == x.rid) {
+		ml->wheel = wh.f;
+	}
+	if (pan.f.size && pan.rid == x.rid) {
+		ml->pan = pan.f;
+	}
+	ml->valid = true;
+}
+
+/* Signed (or, for buttons, unsigned) bit field of a report. */
+static int32_t
+get_bits(const uint8_t *r, uint32_t rlen, struct field f, bool sign)
+{
+	uint32_t v = 0;
+	if (!f.size || f.off + f.size > rlen * 8) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < f.size; i++) {
+		uint32_t bit = f.off + i;
+		v |= (uint32_t)((r[bit / 8] >> (bit % 8)) & 1) << i;
+	}
+	if (sign && f.size < 32 && (v & (1u << (f.size - 1)))) {
+		v |= ~0u << f.size;
+	}
+	return (int32_t)v;
+}
+
+/* Drain the event ring. */
+static void
+poll_events(struct hc *h)
+{
+	bool any = false;
+	for (;;) {
+		struct trb *e = &h->evt[h->evt_deq];
+		dsync(h, e, sizeof(*e));
+		uint32_t ctrl = e->ctrl;
+		if ((ctrl & TRB_C) != h->ccs) {
+			break;
+		}
+		__builtin_arm_dmb(0xb);
+		uint32_t type = (ctrl >> 10) & 0x3f, cc = e->status >> 24;
+		uint32_t slot = ctrl >> 24;
+		switch (type) {
+		case TRB_EV_CMD:
+			h->cmd_cc = cc;
+			h->cmd_slot = slot;
+			h->cmd_done = true;
+			break;
+		case TRB_EV_TRANSFER: {
+			uint32_t epid = (ctrl >> 16) & 0x1f;
+			struct dev *d = dev_by_slot(h, slot);
+			if (epid == 1) {
+				h->xfer_cc = cc;
+				h->xfer_slot = slot;
+				h->xfer_rem = e->status & 0xffffff;
+				h->xfer_done = true;
+			} else if (d && d->eth.on && epid == d->eth.in_dci) {
+				uint32_t len = ETH_RXB - MIN(e->status & 0xffffff, ETH_RXB);
+				if (cc == CC_SUCCESS || cc == CC_SHORT) {
+					eth_rx(h, d, len);
+				} else if (xdebug) {
+					printf("SWEET USB: hc%d slot %u eth rx completion %u\n", h->idx, slot, cc);
+				}
+				ring_put(h, &d->eth.in, (uint32_t)d->eth.rx_dma, (uint32_t)(d->eth.rx_dma >> 32),
+				    ETH_RXB, TRB_TYPE(TRB_NORMAL) | TRB_IOC | TRB_ISP);
+				doorbell(h, d->slot, d->eth.in_dci);
+			} else if (d && d->eth.on && epid == d->eth.out_dci) {
+				if (cc != CC_SUCCESS && cc != CC_SHORT && xdebug) {
+					printf("SWEET USB: hc%d slot %u eth tx completion %u\n", h->idx, slot, cc);
+				}
+				en_tx_done();
+			} else if (d) {
+				for (int i = 0; i < MAX_HID; i++) {
+					struct hid_if *hi = &d->hid[i];
+					if (hi->used && hi->dci == epid) {
+						uint32_t len = hi->mps - MIN(e->status & 0xffffff, hi->mps);
+						if (cc == CC_SUCCESS || cc == CC_SHORT) {
+							hid_report(h, d, hi, len);
+						} else if (xdebug) {
+							printf("SWEET USB: hc%d slot %u ep %u completion %u\n", h->idx, slot, epid, cc);
+						}
+						/* Re-arm (also after an error, so input keeps flowing). */
+						ring_put(h, &hi->ring, (uint32_t)hi->rep_dma, (uint32_t)(hi->rep_dma >> 32),
+						    hi->mps, TRB_TYPE(TRB_NORMAL) | TRB_IOC | TRB_ISP);
+						doorbell(h, d->slot, hi->dci);
+					}
+				}
+			}
+			break;
+		}
+		case TRB_EV_PORT:
+			h->rescan = true;
+			break;
+		default:
+			break;
+		}
+		any = true;
+		if (++h->evt_deq == EVT_TRBS) {
+			h->evt_deq = 0;
+			h->ccs ^= 1;
+		}
+	}
+	if (any) {
+		wr64(h->rt, IR_ERDP, (h->evt_dma + (uint64_t)h->evt_deq * sizeof(struct trb)) | (1u << 3));
+	}
+}
+
+static int
+wait_flag(struct hc *h, bool *flag, uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms * 10; i++) {
+		poll_events(h);
+		if (*flag) {
+			return 0;
+		}
+		delay(100);
+	}
+	return ETIMEDOUT;
+}
+
+static int
+command(struct hc *h, uint32_t p0, uint32_t p1, uint32_t ctrl, uint32_t *slot_out)
+{
+	h->cmd_done = false;
+	dsync(h, h->dma, D_SP);         /* contexts, DCBAA: written by the CPU just now */
+	ring_put(h, &h->cmd, p0, p1, 0, ctrl);
+	doorbell(h, 0, 0);
+	if (wait_flag(h, &h->cmd_done, 1000)) {
+		printf("SWEET USB: hc%d command type %u timed out\n", h->idx, (ctrl >> 10) & 0x3f);
+		return ETIMEDOUT;
+	}
+	if (h->cmd_cc != CC_SUCCESS) {
+		printf("SWEET USB: hc%d command type %u failed: completion %u\n",
+		    h->idx, (ctrl >> 10) & 0x3f, h->cmd_cc);
+		return EIO;
+	}
+	if (slot_out) {
+		*slot_out = h->cmd_slot;
+	}
+	return 0;
+}
+
+/* Control transfer on EP0; IN data lands in the device's DV_BUF. */
+static int
+control(struct hc *h, struct dev *d, uint8_t rt, uint8_t req, uint16_t val, uint16_t idx,
+    uint16_t len, uint32_t *got)
+{
+	bool in = (rt & 0x80) != 0;
+	uint32_t setup0 = rt | (uint32_t)req << 8 | (uint32_t)val << 16;
+	uint32_t setup1 = idx | (uint32_t)len << 16;
+	uint32_t trt = len ? (in ? 3u : 2u) : 0u;
+	uint64_t buf = d->base_dma + DV_BUF;
+
+	if (len) {
+		dsync(h, d->base + DV_BUF, len);
+	}
+	h->xfer_done = false;
+	ring_put(h, &d->ep0, setup0, setup1, 8, TRB_TYPE(TRB_SETUP) | TRB_IDT | trt << 16);
+	if (len) {
+		ring_put(h, &d->ep0, (uint32_t)buf, (uint32_t)(buf >> 32), len,
+		    TRB_TYPE(TRB_DATA) | (in ? 1u << 16 : 0));
+	}
+	ring_put(h, &d->ep0, 0, 0, 0, TRB_TYPE(TRB_STATUS) | TRB_IOC | ((len && in) ? 0 : 1u << 16));
+	doorbell(h, d->slot, 1);
+	/*
+	 * Only the status TRB asks for an event; an error (or a short packet) in
+	 * an earlier stage reports one too, and then the status event follows.
+	 */
+	for (int stage = 0; stage < 3; stage++) {
+		if (wait_flag(h, &h->xfer_done, 1000)) {
+			printf("SWEET USB: hc%d slot %u control 0x%02x/0x%02x timed out\n", h->idx, d->slot, rt, req);
+			return ETIMEDOUT;
+		}
+		if (h->xfer_cc == CC_SUCCESS) {
+			break;
+		}
+		if (h->xfer_cc != CC_SHORT) {
+			if (xdebug || req == 6) {
+				printf("SWEET USB: hc%d slot %u control 0x%02x/0x%02x completion %u\n",
+				    h->idx, d->slot, rt, req, h->xfer_cc);
+			}
+			return EIO;
+		}
+		h->xfer_done = false;
+	}
+	if (len) {
+		dsync(h, d->base + DV_BUF, len);        /* drop lines fetched during the transfer */
+	}
+	if (got) {
+		*got = len;
+	}
+	return 0;
+}
+
+static uint32_t *
+ctx(struct hc *h, uint8_t *base, uint32_t index)
+{
+	return (uint32_t *)(base + index * h->ctxsz);
+}
+
+static void
+dev_free(struct hc *h, struct dev *d)
+{
+	if (d->eth.on) {
+		en_detach_dev(d);
+	}
+	if (d->slot) {
+		(void)command(h, 0, 0, TRB_TYPE(TRB_DISABLE_SLOT) | (uint32_t)d->slot << 24, NULL);
+		((uint64_t *)(h->dma + D_DCBAA))[d->slot] = 0;
+	}
+	bzero(d, sizeof(*d));
+}
+
+/* Interval for an interrupt endpoint context (2^n x 125 us). */
+static uint32_t
+ep_interval(uint8_t speed, uint8_t binterval)
+{
+	if (speed >= 3) {               /* high/super speed: bInterval is already 2^(n-1) frames */
+		return MIN(MAX(binterval, 1) - 1u, 15u);
+	}
+	uint32_t uframes = MAX(binterval, 1) * 8u, n = 0;
+	while ((2u << n) <= uframes && n < 10) {
+		n++;
+	}
+	return MAX(n, 3u);
+}
+
+/*
+ * en1: the iPhone tethering link as an Ethernet ifnet, plus the IOKit objects
+ * configd needs (sweet_net_register) so it runs DHCP, routes and DNS on it.
+ * One iPhone at a time; the ifnet stays across unplug/replug (link off/on).
+ */
+#define EN_TXQ  32
+static LCK_GRP_DECLARE(sweet_en_grp, "sweet_en");
+static LCK_MTX_DECLARE(sweet_en_lock, &sweet_en_grp);
+static struct {
+	ifnet_t ifp;
+	struct hc *h;
+	struct dev *d;          /* the attached iPhone, or NULL */
+	bool tx_busy;
+	mbuf_t q[EN_TXQ];
+	uint32_t head, count;
+	uint64_t rx, tx, drops;
+} en;
+
+/* Next queued frame out through bulk OUT, if idle. Lock held. */
+static void
+en_tx_kick_locked(void)
+{
+	while (en.d && !en.tx_busy && en.count) {
+		mbuf_t m = en.q[en.head];
+		en.head = (en.head + 1) % EN_TXQ;
+		en.count--;
+		size_t len = mbuf_pkthdr_len(m);
+		if (len < ETHER_HDR_LEN || len > ETHER_MAX_LEN - ETHER_CRC_LEN) {
+			mbuf_freem(m);
+			continue;
+		}
+		struct dev *d = en.d;
+		mbuf_copydata(m, 0, len, d->eth.tx);
+		mbuf_freem(m);
+		/* A multiple of the packet size would need a zero-length packet: pad one byte. */
+		if ((len % d->eth.out_mps) == 0) {
+			d->eth.tx[len++] = 0;
+		}
+		dsync(en.h, d->eth.tx, len);
+		ring_put(en.h, &d->eth.out, (uint32_t)d->eth.tx_dma, (uint32_t)(d->eth.tx_dma >> 32),
+		    (uint32_t)len, TRB_TYPE(TRB_NORMAL) | TRB_IOC);
+		doorbell(en.h, d->slot, d->eth.out_dci);
+		en.tx_busy = true;
+		en.tx++;
+	}
+}
+
+static errno_t
+en_output(ifnet_t ifp, mbuf_t m)
+{
+	lck_mtx_lock(&sweet_en_lock);
+	if (!en.d || en.count == EN_TXQ) {
+		en.drops++;
+		lck_mtx_unlock(&sweet_en_lock);
+		mbuf_freem(m);
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
+	ifnet_stat_increment_out(ifp, 1, mbuf_pkthdr_len(m), 0);
+	en.q[(en.head + en.count) % EN_TXQ] = m;
+	en.count++;
+	en_tx_kick_locked();
+	lck_mtx_unlock(&sweet_en_lock);
+	return 0;
+}
+
+/* Bulk OUT completed (xHCI thread). */
+static void
+en_tx_done(void)
+{
+	lck_mtx_lock(&sweet_en_lock);
+	en.tx_busy = false;
+	en_tx_kick_locked();
+	lck_mtx_unlock(&sweet_en_lock);
+}
+
+static errno_t
+en_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	switch (cmd) {
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64: {
+		struct ifmediareq *ifmr = (struct ifmediareq *)data;
+		user_addr_t list = (cmd == SIOCGIFMEDIA64) ?
+		    ((struct ifmediareq64 *)ifmr)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)ifmr)->ifmu_ulist);
+		int media = IFM_ETHER | IFM_AUTO;
+		bool up = en.d != NULL;
+		ifmr->ifm_current = media;
+		ifmr->ifm_active = up ? (IFM_ETHER | IFM_100_TX | IFM_FDX) : media;
+		ifmr->ifm_mask = 0;
+		ifmr->ifm_status = IFM_AVALID | (up ? IFM_ACTIVE : 0);
+		ifmr->ifm_count = 1;
+		if (list != USER_ADDR_NULL && ifmr->ifm_count > 0) {
+			return copyout(&media, list, sizeof(media));
+		}
+		return 0;
+	}
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static void
+en_detach_cb(ifnet_t ifp __unused)
+{
+}
+
+static void
+en_link(bool up)
+{
+	if (en.ifp) {
+		dlil_post_msg(en.ifp, KEV_DL_SUBCLASS, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF, NULL, 0, FALSE);
+	}
+	sweet_net_link(up);
+}
+
+/* The iPhone link is ready: create en1 once, then (re)attach it to this device. */
+static void
+en_attach(struct hc *h, struct dev *d)
+{
+	if (!en.ifp) {
+		struct ifnet_init_eparams init;
+		bzero(&init, sizeof(init));
+		init.ver = IFNET_INIT_CURRENT_VERSION;
+		init.len = sizeof(init);
+		init.flags = IFNET_INIT_LEGACY;
+		init.uniqueid = "sweet-ipheth";
+		init.uniqueid_len = sizeof("sweet-ipheth") - 1;
+		init.name = "en";
+		init.unit = 1;
+		init.family = IFNET_FAMILY_ETHERNET;
+		init.type = IFT_ETHER;
+		init.output = en_output;
+		init.demux = ether_demux;
+		init.add_proto = ether_add_proto;
+		init.del_proto = ether_del_proto;
+		init.check_multi = ether_check_multi;
+		init.framer_extended = ether_frameout_extended;
+		init.ioctl = en_ioctl;
+		init.detach = en_detach_cb;
+		init.broadcast_addr = etherbroadcastaddr;
+		init.broadcast_len = ETHER_ADDR_LEN;
+		if (ifnet_allocate_extended(&init, &en.ifp) != 0) {
+			printf("SWEET USB: en1 ifnet_allocate failed\n");
+			en.ifp = NULL;
+			return;
+		}
+		ifnet_set_addrlen(en.ifp, ETHER_ADDR_LEN);
+		ifnet_set_hdrlen(en.ifp, sizeof(struct ether_header));
+		ifnet_set_mtu(en.ifp, ETHERMTU);
+		ifnet_set_baudrate(en.ifp, 480000000);
+		ifnet_set_flags(en.ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+		if (ifnet_attach(en.ifp, NULL) != 0) {
+			printf("SWEET USB: en1 ifnet_attach failed\n");
+			en.ifp = NULL;
+			return;
+		}
+		/* The host side's address is the one the phone hands out (as Linux ipheth). */
+		ifnet_set_lladdr(en.ifp, d->eth.mac, ETHER_ADDR_LEN);
+		sweet_net_register("en", 1, d->eth.mac, "iPhone USB Ethernet");
+	}
+	lck_mtx_lock(&sweet_en_lock);
+	en.h = h;
+	en.d = d;
+	en.tx_busy = false;
+	lck_mtx_unlock(&sweet_en_lock);
+	ifnet_set_flags(en.ifp, IFF_RUNNING, IFF_RUNNING);
+	en_link(true);
+	printf("SWEET USB: en1 up (iPhone tethering), waiting for configd/DHCP\n");
+}
+
+static void
+en_detach_dev(struct dev *d)
+{
+	lck_mtx_lock(&sweet_en_lock);
+	if (en.d != d) {
+		lck_mtx_unlock(&sweet_en_lock);
+		return;
+	}
+	en.d = NULL;
+	en.tx_busy = false;
+	while (en.count) {
+		mbuf_freem(en.q[en.head]);
+		en.head = (en.head + 1) % EN_TXQ;
+		en.count--;
+	}
+	lck_mtx_unlock(&sweet_en_lock);
+	ifnet_set_flags(en.ifp, 0, IFF_RUNNING);
+	en_link(false);
+	printf("SWEET USB: en1 link down (iPhone unplugged): rx %llu tx %llu drops %llu\n", en.rx, en.tx, en.drops);
+}
+
+/*
+ * iPhone USB tethering, step 1: find the configuration with the Apple USB
+ * Ethernet interface (class 0xff, subclass 0xfd, protocol 1; the alternate
+ * setting with a bulk IN and a bulk OUT endpoint), select it, read the
+ * phone's MAC and carrier (vendor requests 0x00 and 0x45, as Linux ipheth)
+ * and keep a bulk IN transfer queued, logging what arrives. Data only flows
+ * once the phone trusts this host (pairing: next step) with Personal Hotspot
+ * on.
+ */
+static void
+iphone_setup(struct hc *h, struct dev *d, uint8_t ncfg)
+{
+	uint8_t *buf = d->base + DV_BUF, *in = d->base + DV_IN;
+	uint8_t cfgval = 0, iface = 0, alt = 0, ep_in = 0, ep_out = 0;
+	uint16_t mps_in = 0, mps_out = 0;
+	uint32_t got;
+
+	for (uint8_t c = 0; c < ncfg && !cfgval; c++) {
+		got = 0;
+		if (control(h, d, 0x80, 6, (uint16_t)(0x0200 | c), 0, 9, &got)) {
+			continue;
+		}
+		uint16_t total = (uint16_t)MIN((uint32_t)(buf[2] | buf[3] << 8), 1024u);
+		uint8_t val = buf[5];
+		if (control(h, d, 0x80, 6, (uint16_t)(0x0200 | c), 0, total, &got)) {
+			continue;
+		}
+		bool cur = false;
+		uint8_t ci = 0, ca = 0, ei = 0, eo = 0;
+		uint16_t mi = 0, mo = 0;
+		for (uint32_t off = 0; off + 2 <= total && buf[off] >= 2; off += buf[off]) {
+			const uint8_t *x = &buf[off];
+			if (x[1] == 4 && x[0] >= 9) {
+				if (xdebug) {
+					printf("SWEET USB: iPhone config %u interface %u alt %u class %02x/%02x/%02x, %u endpoints\n",
+					    val, x[2], x[3], x[5], x[6], x[7], x[4]);
+				}
+				cur = x[5] == 0xff && x[6] == 0xfd && x[7] == 1;
+				ci = x[2];
+				ca = x[3];
+				ei = eo = 0;
+			} else if (x[1] == 5 && x[0] >= 7 && cur && (x[3] & 3) == 2) {   /* bulk */
+				uint16_t mps = (uint16_t)(x[4] | (x[5] & 7) << 8);
+				if (x[2] & 0x80) {
+					ei = x[2] & 0xf;
+					mi = mps;
+				} else {
+					eo = x[2] & 0xf;
+					mo = mps;
+				}
+				if (ei && eo) {
+					cfgval = val;
+					iface = ci;
+					alt = ca;
+					ep_in = ei;
+					ep_out = eo;
+					mps_in = mi;
+					mps_out = mo;
+					break;
+				}
+			}
+		}
+	}
+	if (!cfgval) {
+		printf("SWEET USB: hc%d port %u: Apple device without USB Ethernet in %u configurations\n",
+		    h->idx, d->port, ncfg);
+		return;
+	}
+	if (control(h, d, 0x00, 9, cfgval, 0, 0, NULL) ||                    /* SET_CONFIGURATION */
+	    control(h, d, 0x01, 11, alt, iface, 0, NULL)) {                  /* SET_INTERFACE */
+		printf("SWEET USB: iPhone: selecting configuration %u / interface %u alt %u failed\n",
+		    cfgval, iface, alt);
+		return;
+	}
+
+	d->eth.iface = iface;
+	d->eth.alt = alt;
+	d->eth.in_dci = (uint8_t)(2 * ep_in + 1);
+	d->eth.out_dci = (uint8_t)(2 * ep_out);
+	d->eth.in_mps = mps_in;
+	d->eth.out_mps = mps_out;
+	d->eth.rx = d->base + DV_RXB;
+	d->eth.rx_dma = d->base_dma + DV_RXB;
+	d->eth.tx = d->base + DV_TXB;
+	d->eth.tx_dma = d->base_dma + DV_TXB;
+	ring_init(h, &d->eth.in, d->base + DV_INT(0), INT_TRBS);
+	ring_init(h, &d->eth.out, d->base + DV_INT(1), INT_TRBS);
+
+	/* Configure Endpoint: bulk IN (type 6) and bulk OUT (type 2). */
+	ctx(h, in, 0)[0] = 0;
+	ctx(h, in, 0)[1] = 1u | 1u << d->eth.in_dci | 1u << d->eth.out_dci;
+	uint32_t *sc = ctx(h, in, 1);
+	sc[0] = (sc[0] & ~(0x1fu << 27)) | ((uint32_t)MAX(d->eth.in_dci, d->eth.out_dci) << 27);
+	struct {
+		uint8_t dci, type;
+		uint16_t mps;
+		struct ring *r;
+	} eps[2] = {
+		{ d->eth.in_dci, 6, mps_in, &d->eth.in },
+		{ d->eth.out_dci, 2, mps_out, &d->eth.out },
+	};
+	for (int i = 0; i < 2; i++) {
+		uint32_t *ec = ctx(h, in, 1 + eps[i].dci);
+		bzero(ec, h->ctxsz);
+		ec[1] = (3u << 1) | ((uint32_t)eps[i].type << 3) | ((uint32_t)eps[i].mps << 16);
+		ec[2] = (uint32_t)eps[i].r->dma | 1;
+		ec[3] = (uint32_t)(eps[i].r->dma >> 32);
+		ec[4] = 1024;
+	}
+	uint64_t in_dma = d->base_dma + DV_IN;
+	if (command(h, (uint32_t)in_dma, (uint32_t)(in_dma >> 32), TRB_TYPE(TRB_CONFIG_EP) | (uint32_t)d->slot << 24, NULL)) {
+		return;
+	}
+
+	got = 0;
+	if (control(h, d, 0xc1, 0x00, 0, iface, 6, &got) == 0) {             /* GET_MACADDR */
+		memcpy(d->eth.mac, buf, 6);
+	}
+	int carrier = -1;
+	if (control(h, d, 0xc1, 0x45, 0, iface, 1, &got) == 0) {              /* CARRIER_CHECK */
+		carrier = buf[0];
+	}
+	d->eth.on = true;
+	ring_put(h, &d->eth.in, (uint32_t)d->eth.rx_dma, (uint32_t)(d->eth.rx_dma >> 32), ETH_RXB,
+	    TRB_TYPE(TRB_NORMAL) | TRB_IOC | TRB_ISP);
+	doorbell(h, d->slot, d->eth.in_dci);
+	printf("SWEET USB: iPhone USB Ethernet: config %u interface %u alt %u, bulk in %u (%u) out %u (%u), "
+	    "MAC %02x:%02x:%02x:%02x:%02x:%02x, carrier 0x%x (%s)\n",
+	    cfgval, iface, alt, ep_in, mps_in, ep_out, mps_out,
+	    d->eth.mac[0], d->eth.mac[1], d->eth.mac[2], d->eth.mac[3], d->eth.mac[4], d->eth.mac[5],
+	    carrier, carrier == 4 ? "on: tethering active" : "off: needs Trust + Personal Hotspot");
+	en_attach(h, d);
+}
+
+/* Received frame: 2 bytes of padding, then the Ethernet frame. Logged for now. */
+static void
+eth_rx(struct hc *h, struct dev *d, uint32_t len)
+{
+	uint8_t *f = d->eth.rx;
+	dsync(h, f, ETH_RXB);
+	d->eth.frames++;
+	/* Into the network stack (en1). One mbuf with a 2 KiB cluster holds any frame. */
+	uint32_t flen = len >= 2 ? len - 2 : 0;
+	if (en.ifp && en.d == d && flen >= ETHER_HDR_LEN && flen <= ETHER_MAX_LEN) {
+		mbuf_t m = NULL;
+		if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+		    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+		    (mbuf_flags(m) & MBUF_EXT) && mbuf_maxlen(m) >= flen) {
+			struct ifnet_stat_increment_param stats = {};
+			memcpy(mbuf_data(m), f + 2, flen);
+			mbuf_setlen(m, flen);
+			mbuf_pkthdr_setlen(m, flen);
+			void *frame_header = mbuf_data(m);
+			mbuf_pkthdr_setrcvif(m, en.ifp);
+			mbuf_pkthdr_setheader(m, frame_header);
+			mbuf_pkthdr_adjustlen(m, -ETHER_HDR_LEN);
+			(void)mbuf_setdata(m, (char *)mbuf_data(m) + ETHER_HDR_LEN, mbuf_len(m) - ETHER_HDR_LEN);
+			stats.packets_in = 1;
+			stats.bytes_in = flen;
+			en.rx++;
+			ifnet_input(en.ifp, m, &stats);
+		} else if (m != NULL) {
+			mbuf_freem(m);
+		}
+	}
+	if (len >= 2 + 14 && (d->eth.frames <= 20 || xdebug > 1)) {
+		const uint8_t *e = f + 2;
+		printf("SWEET USB: iPhone frame %u: %u bytes, %02x:%02x:%02x:%02x:%02x:%02x <- "
+		    "%02x:%02x:%02x:%02x:%02x:%02x type 0x%02x%02x\n", d->eth.frames, len - 2,
+		    e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7], e[8], e[9], e[10], e[11], e[12], e[13]);
+	}
+}
+
+static void
+enumerate(struct hc *h, uint32_t port)
+{
+	uint32_t ps = rd32(h->op, OP_PORTSC(port));
+	if (!(ps & PS_CCS)) {
+		return;
+	}
+	for (int i = 0; i < MAX_DEV; i++) {
+		if (h->dev[i].used && h->dev[i].port == port) {
+			return;
+		}
+	}
+	if (!(ps & PS_PED)) {
+		/* USB 2 port: reset it to enable. */
+		wr32(h->op, OP_PORTSC(port), (ps & PS_KEEP) | PS_PR);
+		for (int i = 0; i < 500 && !(rd32(h->op, OP_PORTSC(port)) & PS_PRC); i++) {
+			delay(1000);
+		}
+		ps = rd32(h->op, OP_PORTSC(port));
+		wr32(h->op, OP_PORTSC(port), (ps & PS_KEEP) | PS_PRC);
+		IOSleep(20);
+		ps = rd32(h->op, OP_PORTSC(port));
+		if (!(ps & PS_PED)) {
+			printf("SWEET USB: hc%d port %u did not enable (portsc 0x%x)\n", h->idx, port, ps);
+			return;
+		}
+	}
+	uint8_t speed = (ps >> 10) & 0xf;
+	int di = -1;
+	for (int i = 0; i < MAX_DEV; i++) {
+		if (!h->dev[i].used) {
+			di = i;
+			break;
+		}
+	}
+	if (di < 0) {
+		return;
+	}
+	struct dev *d = &h->dev[di];
+	bzero(d, sizeof(*d));
+	d->used = true;
+	d->port = (uint8_t)port;
+	d->speed = speed;
+	d->base = h->dma + D_DEV(di);
+	d->base_dma = dma_of(h, d->base);
+	bzero(d->base, DEV_SIZE);
+
+	uint32_t slot;
+	if (command(h, 0, 0, TRB_TYPE(TRB_ENABLE_SLOT), &slot) || slot == 0 || slot > h->slots) {
+		d->used = false;
+		return;
+	}
+	d->slot = (uint8_t)slot;
+	((uint64_t *)(h->dma + D_DCBAA))[slot] = d->base_dma + DV_OUT;
+	ring_init(h, &d->ep0, d->base + DV_EP0, EP0_TRBS);
+
+	/* Input context: A0 (slot) + A1 (EP0). */
+	uint8_t *in = d->base + DV_IN;
+	uint32_t mps0 = speed == 2 ? 8 : speed == 1 ? 8 : speed == 3 ? 64 : 512;
+	ctx(h, in, 0)[1] = 0x3;
+	uint32_t *sc = ctx(h, in, 1);
+	sc[0] = (1u << 27) | ((uint32_t)speed << 20);
+	sc[1] = port << 16;
+	uint32_t *e0 = ctx(h, in, 2);
+	e0[1] = (3u << 1) | (4u << 3) | (mps0 << 16);
+	e0[2] = (uint32_t)d->ep0.dma | 1;
+	e0[3] = (uint32_t)(d->ep0.dma >> 32);
+	e0[4] = 8;
+	uint64_t in_dma = d->base_dma + DV_IN;
+	if (command(h, (uint32_t)in_dma, (uint32_t)(in_dma >> 32), TRB_TYPE(TRB_ADDRESS_DEV) | slot << 24, NULL)) {
+		dev_free(h, d);
+		return;
+	}
+	IOSleep(10);
+
+	uint8_t *buf = d->base + DV_BUF;
+	uint32_t got = 0;
+	if (control(h, d, 0x80, 6, 0x0100, 0, 8, &got)) {
+		dev_free(h, d);
+		return;
+	}
+	if (buf[7] && buf[7] != mps0) {
+		mps0 = buf[7] == 9 ? 512 : buf[7];
+		ctx(h, in, 0)[1] = 0x2;
+		e0[1] = (3u << 1) | (4u << 3) | (mps0 << 16);
+		(void)command(h, (uint32_t)in_dma, (uint32_t)(in_dma >> 32), TRB_TYPE(TRB_EVAL_CTX) | slot << 24, NULL);
+	}
+	got = 0;
+	if (control(h, d, 0x80, 6, 0x0100, 0, 18, &got)) {
+		dev_free(h, d);
+		return;
+	}
+	uint16_t vid = (uint16_t)(buf[8] | buf[9] << 8), pid = (uint16_t)(buf[10] | buf[11] << 8);
+	uint8_t dclass = buf[4];
+	printf("SWEET USB: hc%d port %u: device %04x:%04x class %u speed %u slot %u mps0 %u\n",
+	    h->idx, port, vid, pid, dclass, speed, slot, mps0);
+	if (dclass == 9) {
+		printf("SWEET USB: hubs are not supported yet: plug the keyboard/mouse in directly\n");
+		dev_free(h, d);
+		return;
+	}
+	if (vid == 0x05ac) {
+		/* Apple: an iPhone/iPad offers USB tethering in one of its configurations. */
+		iphone_setup(h, d, buf[17]);
+		return;         /* keep the slot either way (no re-enumeration loop) */
+	}
+	got = 0;
+	if (control(h, d, 0x80, 6, 0x0200, 0, 9, &got)) {
+		dev_free(h, d);
+		return;
+	}
+	uint16_t total = (uint16_t)MIN((uint32_t)(buf[2] | buf[3] << 8), 1024u);
+	uint8_t cfgval = buf[5];
+	got = 0;
+	if (control(h, d, 0x80, 6, 0x0200, 0, total, &got)) {
+		dev_free(h, d);
+		return;
+	}
+	/* Parse: HID boot interfaces and their interrupt IN endpoint. */
+	int nh = 0, cur = -1;
+	uint8_t cfg[1024];
+	memcpy(cfg, buf, total);
+	for (uint32_t off = 0; off + 2 <= total && cfg[off] >= 2; off += cfg[off]) {
+		const uint8_t *x = &cfg[off];
+		if (x[1] == 4 && x[0] >= 9) {           /* interface */
+			cur = -1;
+			/* HID keyboard/mouse, boot subclass or not (many 2.4 GHz dongles omit it). */
+			if (x[5] == 3 && (x[7] == 1 || x[7] == 2) && nh < MAX_HID) {
+				cur = nh++;
+				d->hid[cur].iface = x[2];
+				d->hid[cur].proto = x[7];
+			}
+			if (xdebug) {
+				printf("SWEET USB: interface %u class %u/%u/%u%s\n", x[2], x[5], x[6], x[7],
+				    cur >= 0 ? " (used)" : "");
+			}
+		} else if (x[1] == 0x21 && x[0] >= 9 && cur >= 0 && x[6] == 0x22) {
+			d->hid[cur].rdesc_len = (uint16_t)(x[7] | x[8] << 8);   /* HID: report descriptor size */
+		} else if (x[1] == 5 && x[0] >= 7 && cur >= 0 && !d->hid[cur].used) {
+			if ((x[2] & 0x80) && (x[3] & 3) == 3) {     /* interrupt IN */
+				struct hid_if *hi = &d->hid[cur];
+				hi->ep = x[2] & 0xf;
+				hi->dci = (uint8_t)(2 * hi->ep + 1);
+				hi->mps = (uint16_t)MIN((uint32_t)(x[4] | (x[5] & 7) << 8), 64u);
+				hi->used = true;
+				uint8_t interval = (uint8_t)ep_interval(speed, x[6]);
+				hi->rep = d->base + DV_REP(cur);
+				hi->rep_dma = d->base_dma + DV_REP(cur);
+				ring_init(h, &hi->ring, d->base + DV_INT(cur), INT_TRBS);
+				uint32_t *ec = ctx(h, in, 1 + hi->dci);
+				bzero(ec, h->ctxsz);
+				ec[0] = (uint32_t)interval << 16;
+				ec[1] = (3u << 1) | (7u << 3) | ((uint32_t)hi->mps << 16);
+				ec[2] = (uint32_t)hi->ring.dma | 1;
+				ec[3] = (uint32_t)(hi->ring.dma >> 32);
+				ec[4] = 8 | ((uint32_t)hi->mps << 16);
+			}
+		}
+	}
+	uint32_t add = 1, maxdci = 1;
+	for (int i = 0; i < MAX_HID; i++) {
+		if (d->hid[i].used) {
+			add |= 1u << d->hid[i].dci;
+			maxdci = MAX(maxdci, d->hid[i].dci);
+		}
+	}
+	if (add == 1) {
+		printf("SWEET USB: hc%d port %u: no HID keyboard/mouse interface\n", h->idx, port);
+		/* Keep the slot so the port is not re-enumerated until unplugged. */
+		return;
+	}
+	if (control(h, d, 0x00, 9, cfgval, 0, 0, NULL)) {
+		dev_free(h, d);
+		return;
+	}
+	ctx(h, in, 0)[0] = 0;
+	ctx(h, in, 0)[1] = add;
+	sc[0] = (sc[0] & ~(0x1fu << 27)) | (maxdci << 27);
+	if (command(h, (uint32_t)in_dma, (uint32_t)(in_dma >> 32), TRB_TYPE(TRB_CONFIG_EP) | slot << 24, NULL)) {
+		dev_free(h, d);
+		return;
+	}
+	for (int i = 0; i < MAX_HID; i++) {
+		struct hid_if *hi = &d->hid[i];
+		if (!hi->used) {
+			continue;
+		}
+		if (hi->proto == 2) {
+			/* Mice: report protocol with the device's own layout (wheel included). */
+			uint16_t rl = (uint16_t)MIN(hi->rdesc_len ? hi->rdesc_len : 512u, 1024u);
+			uint32_t got = 0;
+			if (control(h, d, 0x81, 6, 0x2200, hi->iface, rl, &got) == 0) {
+				parse_mouse(d->base + DV_BUF, rl, &hi->ml);
+			}
+			if (hi->ml.valid) {
+				(void)control(h, d, 0x21, 0x0b, 1, hi->iface, 0, NULL); /* SET_PROTOCOL report */
+				printf("SWEET USB: mouse layout: id %u, buttons %u@%u, x %u@%u, y %u@%u, wheel %u@%u, pan %u@%u\n",
+				    hi->ml.ids ? hi->ml.rid : 0, hi->ml.nbtn, hi->ml.btn.off, hi->ml.x.size, hi->ml.x.off,
+				    hi->ml.y.size, hi->ml.y.off, hi->ml.wheel.size, hi->ml.wheel.off,
+				    hi->ml.pan.size, hi->ml.pan.off);
+			} else {
+				printf("SWEET USB: mouse report descriptor not understood: boot protocol (no wheel)\n");
+				(void)control(h, d, 0x21, 0x0b, 0, hi->iface, 0, NULL);
+			}
+		} else {
+			(void)control(h, d, 0x21, 0x0b, 0, hi->iface, 0, NULL);        /* SET_PROTOCOL boot */
+			(void)control(h, d, 0x21, 0x0a, 0, hi->iface, 0, NULL);        /* SET_IDLE 0 */
+		}
+		ring_put(h, &hi->ring, (uint32_t)hi->rep_dma, (uint32_t)(hi->rep_dma >> 32), hi->mps,
+		    TRB_TYPE(TRB_NORMAL) | TRB_IOC | TRB_ISP);
+		doorbell(h, d->slot, hi->dci);
+		printf("SWEET USB: hc%d port %u: %s on interface %u, endpoint %u\n", h->idx, port,
+		    hi->proto == 1 ? "keyboard" : "mouse", hi->iface, hi->ep);
+	}
+}
+
+/* Keyboard usages that act as iPad buttons instead of keys. */
+static bool
+kbd_special(uint8_t usage, int down)
+{
+	switch (usage) {
+	case 0x29:      /* Esc: Home (every keyboard has one) */
+	case 0x3a:      /* F1 (Back on Chromebook-style keyboards): Home */
+		sweet_hid_key(3, down);
+		return true;
+	case 0x3b:      /* F2: side button (lock) */
+		sweet_hid_key(0, down);
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool
+contains(const uint8_t *keys, uint8_t k)
+{
+	for (int i = 0; i < 6; i++) {
+		if (keys[i] == k) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+hid_report(struct hc *h, struct dev *d, struct hid_if *hi, uint32_t len)
+{
+	uint8_t r[8] = { 0 };
+	dsync(h, hi->rep, 64);
+	memcpy(r, hi->rep, MIN(len, 8u));
+	if (xdebug) {
+		printf("SWEET USB: hc%d slot %u %s report %u: %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    h->idx, d->slot, hi->proto == 1 ? "kbd" : "mouse", len,
+		    r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7]);
+	}
+	if (hi->proto == 1) {
+		if (len < 3 || r[2] == 1) {     /* phantom state (rollover) */
+			return;
+		}
+		uint8_t mods = r[0], old = hi->last[0];
+		for (int b = 0; b < 8; b++) {
+			if ((mods ^ old) & (1u << b)) {
+				sweet_hid_kbd(7, 0xe0 + b, (mods >> b) & 1);
+			}
+		}
+		for (int i = 2; i < 8; i++) {   /* released */
+			uint8_t k = hi->last[i];
+			if (k > 3 && !contains(&r[2], k) && !kbd_special(k, 0)) {
+				sweet_hid_kbd(7, k, 0);
+			}
+		}
+		for (int i = 2; i < 8; i++) {   /* pressed */
+			uint8_t k = r[i];
+			if (k > 3 && !contains(&hi->last[2], k) && !kbd_special(k, 1)) {
+				sweet_hid_kbd(7, k, 1);
+			}
+		}
+		memcpy(hi->last, r, 8);
+	} else if (hi->ml.valid) {
+		const uint8_t *p = hi->rep;
+		uint32_t n = MIN(len, (uint32_t)hi->mps);
+		if (hi->ml.ids) {
+			if (n < 1 || p[0] != hi->ml.rid) {
+				return;                 /* another report of this device */
+			}
+			p++;
+			n--;
+		}
+		uint32_t buttons = hi->ml.nbtn ? (uint32_t)get_bits(p, n,
+		    (struct field){ hi->ml.btn.off, hi->ml.nbtn }, false) & 7 : 0;
+		int dx = get_bits(p, n, hi->ml.x, true), dy = get_bits(p, n, hi->ml.y, true);
+		int wheel = get_bits(p, n, hi->ml.wheel, true), pan = get_bits(p, n, hi->ml.pan, true);
+		sweet_hid_pointer(dx, dy, buttons, wheel * scroll_mult, pan * scroll_mult);
+	} else {
+		if (len < 3) {
+			return;
+		}
+		sweet_hid_pointer((int8_t)r[1], (int8_t)r[2], r[0] & 7, 0, 0);
+	}
+}
+
+static int
+hc_init(struct hc *h, uint64_t pa, uint64_t size)
+{
+	h->regs = ml_io_map(pa, size);
+	uint32_t ver = rd32(h->regs, CAP_LENGTH);
+	uint32_t gctl = rd32(h->regs, DWC3_GCTL);
+	printf("SWEET USB: hc%d at 0x%llx: caplength/version 0x%08x, DWC3 GCTL 0x%08x\n", h->idx, pa, ver, gctl);
+	if (ver == 0xffffffff || ((ver >> 16) != 0x100 && (ver >> 16) != 0x110 && (ver >> 16) != 0x120)) {
+		printf("SWEET USB: hc%d: no xHCI here\n", h->idx);
+		return ENXIO;
+	}
+	if (((gctl >> 12) & 3) != 1) {
+		wr32(h->regs, DWC3_GCTL, (gctl & ~(3u << 12)) | (1u << 12));
+		IOSleep(10);
+		printf("SWEET USB: hc%d: DWC3 switched to host mode (GCTL 0x%08x)\n", h->idx, rd32(h->regs, DWC3_GCTL));
+	}
+	h->op = h->regs + (ver & 0xff);
+	h->rt = h->regs + (rd32(h->regs, CAP_RTSOFF) & ~0x1fu);
+	h->db = h->regs + (rd32(h->regs, CAP_DBOFF) & ~0x3u);
+	uint32_t p1 = rd32(h->regs, CAP_HCSPARAMS1), p2 = rd32(h->regs, CAP_HCSPARAMS2);
+	uint32_t c1 = rd32(h->regs, CAP_HCCPARAMS1);
+	h->slots = MIN(p1 & 0xff, 64u);
+	h->ports = p1 >> 24;
+	h->ctxsz = (c1 & (1u << 2)) ? 64 : 32;
+	h->sp = ((p2 >> 21) & 0x1f) << 5 | (p2 >> 27);
+	if (!(c1 & 1)) {
+		printf("SWEET USB: hc%d has no 64-bit addressing\n", h->idx);
+		return ENXIO;
+	}
+
+	/* Halt and reset. */
+	wr32(h->op, OP_USBCMD, rd32(h->op, OP_USBCMD) & ~CMD_RS);
+	for (int i = 0; i < 200 && !(rd32(h->op, OP_USBSTS) & STS_HCH); i++) {
+		delay(1000);
+	}
+	wr32(h->op, OP_USBCMD, CMD_HCRST);
+	for (int i = 0; i < 1000 && (rd32(h->op, OP_USBCMD) & CMD_HCRST); i++) {
+		delay(1000);
+	}
+	for (int i = 0; i < 1000 && (rd32(h->op, OP_USBSTS) & STS_CNR); i++) {
+		delay(1000);
+	}
+	if (rd32(h->op, OP_USBSTS) & STS_CNR) {
+		printf("SWEET USB: hc%d not ready after reset (sts 0x%x)\n", h->idx, rd32(h->op, OP_USBSTS));
+		return EIO;
+	}
+
+	/* DMA memory: one contiguous block, used through a write-combined mapping. */
+	uint32_t pagesz = (rd32(h->op, OP_PAGESIZE) & 0xffff) << 12;
+	if (pagesz != 4096 && h->sp) {
+		printf("SWEET USB: hc%d page size %u unsupported\n", h->idx, pagesz);
+		return ENXIO;
+	}
+	h->dma_size = round_page_64(D_SP + (uint64_t)h->sp * 4096);
+	vm_offset_t va;
+	if (kmem_alloc_contig(kernel_map, &va, (vm_size_t)h->dma_size, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+	if (!pn) {
+		return ENOMEM;
+	}
+	h->dma_pa = ptoa_64(pn);
+	h->dma = (uint8_t *)va;
+	bzero(h->dma, (size_t)h->dma_size);
+
+	uint64_t *dcbaa = (uint64_t *)(h->dma + D_DCBAA);
+	if (h->sp) {
+		uint64_t *arr = (uint64_t *)(h->dma + D_SPARR);
+		for (uint32_t i = 0; i < h->sp; i++) {
+			arr[i] = dma_of(h, h->dma + D_SP + i * 4096);
+		}
+		dcbaa[0] = dma_of(h, arr);
+	}
+	wr32(h->op, OP_CONFIG, h->slots);
+	wr64(h->op, OP_DCBAAP, dma_of(h, dcbaa));
+	ring_init(h, &h->cmd, h->dma + D_CMD, CMD_TRBS);
+	wr64(h->op, OP_CRCR, h->cmd.dma | 1);
+	h->evt = (struct trb *)(h->dma + D_EVT);
+	h->evt_dma = dma_of(h, h->evt);
+	h->evt_deq = 0;
+	h->ccs = 1;
+	uint64_t *erst = (uint64_t *)(h->dma + D_ERST);
+	erst[0] = h->evt_dma;
+	erst[1] = EVT_TRBS;
+	dsync(h, h->dma, (size_t)h->dma_size);
+	wr32(h->rt, IR_IMAN, 0);
+	wr32(h->rt, IR_ERSTSZ, 1);
+	wr64(h->rt, IR_ERDP, h->evt_dma);
+	wr64(h->rt, IR_ERSTBA, dma_of(h, erst));
+	__builtin_arm_dsb(0xf);
+	wr32(h->op, OP_USBCMD, CMD_RS);
+	for (int i = 0; i < 100 && (rd32(h->op, OP_USBSTS) & STS_HCH); i++) {
+		delay(1000);
+	}
+	/* Port power (no-op where ports are always powered). */
+	for (uint32_t p = 1; p <= h->ports; p++) {
+		uint32_t ps = rd32(h->op, OP_PORTSC(p));
+		if (!(ps & PS_PP)) {
+			wr32(h->op, OP_PORTSC(p), (ps & PS_KEEP) | PS_PP);
+		}
+	}
+	printf("SWEET USB: hc%d running: %u ports, %u slots, %u-byte contexts, %u scratchpad pages, DMA 0x%llx (+0x%llx)\n",
+	    h->idx, h->ports, h->slots, h->ctxsz, h->sp, h->dma_pa, dma_off);
+	return 0;
+}
+
+static void
+scan(struct hc *h)
+{
+	h->rescan = false;
+	for (uint32_t p = 1; p <= h->ports; p++) {
+		uint32_t ps = rd32(h->op, OP_PORTSC(p));
+		if (ps & PS_CHANGES) {
+			wr32(h->op, OP_PORTSC(p), (ps & PS_KEEP) | (ps & PS_CHANGES));
+		}
+		if (!(ps & PS_CCS)) {
+			for (int i = 0; i < MAX_DEV; i++) {
+				if (h->dev[i].used && h->dev[i].port == p) {
+					printf("SWEET USB: hc%d port %u: device removed\n", h->idx, p);
+					dev_free(h, &h->dev[i]);
+				}
+			}
+			continue;
+		}
+		enumerate(h, p);
+	}
+}
+
+/*
+ * The Pi 5 power button (firmware DT /pwr_button: brcmstb GPIO 20 at
+ * 0x107d508500, active low; ADT /sweet-xhci power-button = the bank's DATA
+ * register, power-button-bit = 20) acts as the iPad side button. Holding it
+ * still powers the board off in hardware.
+ */
+static vm_offset_t pwr_reg;
+static uint32_t pwr_bit;
+
+static void
+poll_power_button(void)
+{
+	static bool state, cand;
+	static uint32_t stable;
+	if (!pwr_reg) {
+		return;
+	}
+	bool pressed = !(*(volatile uint32_t *)pwr_reg & (1u << pwr_bit));
+	if (pressed != cand) {
+		cand = pressed;
+		stable = 0;
+	} else if (cand != state && ++stable >= 10) {   /* ~40 ms debounce */
+		state = cand;
+		sweet_hid_key(0, state);
+		if (xdebug) {
+			printf("SWEET USB: power button %s\n", state ? "down" : "up");
+		}
+	}
+}
+
+static void
+sweet_xhci_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	IOSleep(2000);          /* power-on settle; the HID services register meanwhile */
+	for (int i = 0; i < nhc; i++) {
+		scan(&hcs[i]);
+	}
+	for (uint32_t tick = 0;; tick++) {
+		poll_power_button();
+		for (int i = 0; i < nhc; i++) {
+			struct hc *h = &hcs[i];
+			poll_events(h);
+			/* Hotplug: port change events, plus a slow fallback scan. */
+			if (h->rescan || (tick % 250) == 0) {
+				IOSleep(h->rescan ? 100 : 0);
+				scan(h);
+			}
+		}
+		IOSleep(4);
+	}
+}
+
+/*
+ * BCM2712 PCIe x4 root complex (brcmstb) and RP1 behind it. What the firmware
+ * leaves with pciex4_reset=0 (measured on the Pi, 2026-11-08): link up,
+ * outbound window 0 = CPU 0x1c00000000 -> PCI 0x80000000 (1 GiB), root port
+ * memory window PCI 0x80000000-0xbfffffff, but the root port's bus numbers
+ * all 0 (so config reads of RP1 fail) and inbound BAR2 = PCI 0 (64 GiB).
+ * Here: give the root port bus 1, read (or assign) RP1's BAR1 inside the
+ * outbound window, turn on memory decode + bus mastering, and move inbound
+ * BAR2 to PCI 0x10_0000_0000 (RP1's DMA masters reach host memory there).
+ * Returns the CPU address of RP1 BAR1 (its 0xc0_40000000 peripheral space),
+ * or 0.
+ */
+#define RC_WIN0_LO              0x400c
+#define RC_WIN0_HI              0x4010
+#define RC_BAR2_LO              0x4034
+#define RC_BAR2_HI              0x4038
+#define RC_STATUS               0x4068
+#define RC_WIN0_BASE_LIMIT      0x4070
+#define RC_WIN0_BASE_HI         0x4080
+#define RC_WIN0_LIMIT_HI        0x4084
+#define RC_UBUS_REMAP_LO        0x40b4
+#define RC_UBUS_REMAP_HI        0x40b8
+#define RC_EXT_CFG_DATA         0x8000
+#define RC_EXT_CFG_INDEX        0x9000
+
+static vm_offset_t rc;
+
+static uint32_t
+rp1_cfg_rd(uint32_t off)
+{
+	wr32(rc, RC_EXT_CFG_INDEX, 1u << 20);   /* bus 1, device 0, function 0 */
+	return rd32(rc, RC_EXT_CFG_DATA + off);
+}
+
+static void
+rp1_cfg_wr(uint32_t off, uint32_t v)
+{
+	wr32(rc, RC_EXT_CFG_INDEX, 1u << 20);
+	wr32(rc, RC_EXT_CFG_DATA + off, v);
+}
+
+static void
+rp1_dump(const char *when)
+{
+	printf("SWEET USB: PCIe %s: RC id 0x%08x cmd 0x%08x bus 0x%08x memwin 0x%08x | win0 pci 0x%08x%08x"
+	    " base/limit 0x%08x hi 0x%x/0x%x | rc bar2 0x%08x%08x remap 0x%08x%08x\n", when,
+	    rd32(rc, 0x00), rd32(rc, 0x04), rd32(rc, 0x18), rd32(rc, 0x20),
+	    rd32(rc, RC_WIN0_HI), rd32(rc, RC_WIN0_LO), rd32(rc, RC_WIN0_BASE_LIMIT),
+	    rd32(rc, RC_WIN0_BASE_HI), rd32(rc, RC_WIN0_LIMIT_HI),
+	    rd32(rc, RC_BAR2_HI), rd32(rc, RC_BAR2_LO),
+	    rd32(rc, RC_UBUS_REMAP_HI), rd32(rc, RC_UBUS_REMAP_LO));
+	printf("SWEET USB: RP1 %s: id 0x%08x cmd 0x%08x bar0 0x%08x bar1 0x%08x bar2 0x%08x\n", when,
+	    rp1_cfg_rd(0x00), rp1_cfg_rd(0x04), rp1_cfg_rd(0x10), rp1_cfg_rd(0x14), rp1_cfg_rd(0x18));
+}
+
+static uint64_t
+rp1_setup(uint64_t rc_pa)
+{
+	rc = ml_io_map(rc_pa, 0xa000);
+	rp1_dump("as found");
+	if ((rd32(rc, 0x18) & 0x0000ff00u) == 0) {
+		wr32(rc, 0x18, (rd32(rc, 0x18) & 0xff000000u) | 0x00010100u);
+		__builtin_arm_dsb(0xf);
+	}
+	uint32_t id = rp1_cfg_rd(0x00);
+	if (id == 0xffffffff || id == 0xdeaddead || id == 0) {
+		printf("SWEET USB: RP1 does not answer config reads (0x%08x)\n", id);
+		return 0;
+	}
+	/* Outbound window 0 as programmed. */
+	uint32_t bl = rd32(rc, RC_WIN0_BASE_LIMIT);
+	uint64_t pci = (uint64_t)rd32(rc, RC_WIN0_HI) << 32 | rd32(rc, RC_WIN0_LO);
+	uint64_t cpu_mb = (uint64_t)rd32(rc, RC_WIN0_BASE_HI) << 12 | ((bl >> 4) & 0xfff);
+	uint64_t lim_mb = (uint64_t)rd32(rc, RC_WIN0_LIMIT_HI) << 12 | (bl >> 20);
+	if (bl == 0 || lim_mb < cpu_mb) {
+		printf("SWEET USB: no outbound PCIe window\n");
+		return 0;
+	}
+	uint64_t cpu = cpu_mb << 20, len = (lim_mb - cpu_mb + 1) << 20;
+	uint32_t cmd = rp1_cfg_rd(0x04);
+	uint64_t bar1 = rp1_cfg_rd(0x14) & ~0xfull;
+	if (bar1 < pci || bar1 + 0x400000 > pci + len) {
+		/* Unassigned (or outside the window): lay RP1 out at the window start. */
+		rp1_cfg_wr(0x04, cmd & ~0x6u);
+		rp1_cfg_wr(0x14, (uint32_t)pci);
+		rp1_cfg_wr(0x18, (uint32_t)pci + 0x400000u);
+		rp1_cfg_wr(0x10, (uint32_t)pci + 0x410000u);
+		bar1 = pci;
+		printf("SWEET USB: RP1 BARs assigned at PCI 0x%llx\n", pci);
+	}
+	rp1_cfg_wr(0x04, rp1_cfg_rd(0x04) | 0x6);       /* memory decode + bus master */
+	wr32(rc, 0x04, rd32(rc, 0x04) | 0x6);
+	/* Inbound: PCI 0x10_0000_0000 -> host memory (size encoding kept). */
+	if (rd32(rc, RC_BAR2_HI) != (uint32_t)(dma_off >> 32)) {
+		wr32(rc, RC_BAR2_LO, (rd32(rc, RC_BAR2_LO) & 0x1f) | (uint32_t)dma_off);
+		wr32(rc, RC_BAR2_HI, (uint32_t)(dma_off >> 32));
+	}
+	__builtin_arm_dsb(0xf);
+	IOSleep(5);
+	rp1_dump("after setup");
+	uint64_t base = cpu + (bar1 - pci);
+	vm_offset_t probe = ml_io_map(base + 0x200000, PAGE_SIZE);
+	printf("SWEET USB: RP1 at CPU 0x%llx (PCI 0x%llx); xHCI 0 reads 0x%08x\n", base, bar1, rd32(probe, 0));
+	return base;
+}
+
+void sweet_xhci_start(void);
+
+static void usb_setup(DTEntry node, uint64_t const *reg, unsigned int size);
+
+void
+sweet_xhci_start(void)
+{
+	DTEntry node;
+	uint64_t const *reg = NULL;
+	unsigned int size = 0;
+	uint32_t on = 1;
+	thread_t thread;
+
+	PE_parse_boot_argn("xhci", &on, sizeof(on));
+	PE_parse_boot_argn("xhcidebug", &xdebug, sizeof(xdebug));
+	PE_parse_boot_argn("xhciscroll", &scroll_mult, sizeof(scroll_mult));
+	if (SecureDTLookupEntry(NULL, "/sweet-xhci", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
+		return;
+	}
+	uint64_t const *pb = NULL;
+	uint32_t const *bit = NULL;
+	unsigned int pbsz = 0, bitsz = 0;
+	if (SecureDTGetProperty(node, "power-button", (void const **)&pb, &pbsz) == kSuccess && pbsz >= 8 &&
+	    SecureDTGetProperty(node, "power-button-bit", (void const **)&bit, &bitsz) == kSuccess && bitsz >= 4) {
+		pwr_reg = ml_io_map(pb[0] & ~(uint64_t)PAGE_MASK, PAGE_SIZE) + (pb[0] & PAGE_MASK);
+		pwr_bit = bit[0] & 31;
+		printf("SWEET USB: power button on GPIO bit %u (%s)\n", pwr_bit,
+		    (*(volatile uint32_t *)pwr_reg & (1u << pwr_bit)) ? "up" : "DOWN?");
+	}
+	if (on) {
+		usb_setup(node, reg, size);
+	}
+	if ((nhc || pwr_reg) && kernel_thread_start(sweet_xhci_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+static void
+usb_setup(DTEntry node, uint64_t const *reg, unsigned int size)
+{
+	uint64_t const *p = NULL;
+	unsigned int psz = 0;
+	uint64_t rp1 = 0;
+	if (SecureDTGetProperty(node, "dma-offset", (void const **)&p, &psz) == kSuccess && psz >= 8) {
+		dma_off = p[0];
+	}
+	PE_parse_boot_argn("xhcidma", &dma_off, sizeof(dma_off));
+	/* RP1 sits behind the PCIe x4 root complex: touch it only with the link up. */
+	if (SecureDTGetProperty(node, "pcie-status", (void const **)&p, &psz) == kSuccess && psz >= 8) {
+		vm_offset_t st = ml_io_map(p[0] & ~(uint64_t)PAGE_MASK, PAGE_SIZE) + (p[0] & PAGE_MASK);
+		uint32_t v = *(volatile uint32_t *)st;
+		printf("SWEET USB: PCIe x4 status 0x%08x\n", v);
+		if ((v & 0x30) != 0x30) {
+			printf("SWEET USB: RP1 PCIe link is down (config.txt pciex4_reset=0?): no USB\n");
+			return;
+		}
+		rp1 = rp1_setup(p[0] - RC_STATUS);
+		if (!rp1) {
+			return;
+		}
+	}
+	for (unsigned i = 0; i + 1 < size / 8 && nhc < MAX_HC; i += 2) {
+		struct hc *h = &hcs[nhc];
+		h->idx = nhc;
+		/* reg is laid out for RP1 BAR1 at CPU 0x1f00000000 (Linux): rebase. */
+		uint64_t pa = rp1 ? rp1 + (reg[i] - 0x1f00000000ull) : reg[i];
+		if (hc_init(h, pa, reg[i + 1]) == 0) {
+			nhc++;
+		}
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
