+	    (base & ARM_TT_L2_OFFMASK) + row_bytes * height > ARM_TT_L2_SIZE) {
+		sweet_early_disable();
+		return;
+	}
+	early_fb_pa = base;
+	early_fb = (volatile uint32_t *)(uintptr_t)base;
+	early_w = (unsigned int)width;
+	early_h = (unsigned int)height;
+	early_stride_px = (unsigned int)(row_bytes / 4);
+}
+
+uint64_t
+sweet_early_fb_pa(void)
+{
+	return early_disabled ? 0 : early_fb_pa;
+}
+
+int
+sweet_early_suspended(void)
+{
+	return !early_disabled && early_suspended;
+}
+
+/*
+ * arm_vm_init after stage 11, once arm_vm_init rewrote the framebuffer block
+ * entry through the final page tables and flushed the TLB: draw again if the
+ * MMU now translates the VA, else give up on the early console (the
+ * sweet-fbcon serial console takes over at serial_init).
+ */
+void
+sweet_early_resume(uint64_t l1, uint64_t slot_before, uint64_t slot_now)
+{
+	uint64_t par;
+	uint64_t va = (uint64_t)(uintptr_t)early_fb;
+	__asm__ volatile ("at s1e1w, %1\n isb\n mrs %0, par_el1" : "=r"(par) : "r"(va) : "memory");
+	if (par & 1) {
+		sweet_early_disable();
+		return;
+	}
+	early_suspended = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	sweet_early_string("SWEET EARLY 11b: fb VA live after retry, PAR ");
+	sweet_early_hex(par);
+	sweet_early_string("\n  L1 ");
+	sweet_early_hex(l1);
+	sweet_early_string(" slot before ");
+	sweet_early_hex(slot_before);
+	sweet_early_string(" now ");
+	sweet_early_hex(slot_now);
+	sweet_early_putc('\n');
+}
+#endif
