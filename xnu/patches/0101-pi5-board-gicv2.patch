+/* SGIs taken per CPU (sleh_irq), for the cross-CPU IPI test in SweetCPU. */
+static uint32_t gic_sgi_rx[SWEET_SMP_MAX_CPUS];
+/* Virtual timer IRQs taken per CPU, and each CPU's banked IGROUPR0 at init. */
+static uint32_t gic_timer_rx[SWEET_SMP_MAX_CPUS];
