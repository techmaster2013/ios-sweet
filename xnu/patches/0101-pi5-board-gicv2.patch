+ * "ifnet_attach ... lo0 ... Proceeding". The SGI1 check in startAll only
+ * proves each CPU can signal itself. Signal every CPU from this thread and
+ * report whether its sleh_irq saw it, without hanging if one is lost.
+ */
+static void
+sweet_ipi_matrix(unsigned int ncpus)
+{
+	for (unsigned int t = 0; t < ncpus; t++) {
+		unsigned int src = cpu_number();
+		uint32_t before = sweet_gic_sgi_rx(t);
+		sweet_gic_send_sgi(t, SWEET_IPI_SGI);
+		uint64_t deadline;
+		nanoseconds_to_deadline(100 * NSEC_PER_MSEC, &deadline);
+		while (sweet_gic_sgi_rx(t) == before && mach_absolute_time() < deadline) {
+			;
+		}
+		IOLog("SWEET IPI: cpu %u -> cpu %u (mask 0x%x): %s\n", src, t,
+		    sweet_gic_cpu_mask(t), sweet_gic_sgi_rx(t) != before ? "OK" : "LOST");
+	}
+}
+#endif
 
