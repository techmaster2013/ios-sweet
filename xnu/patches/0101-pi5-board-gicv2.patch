+/*
+ * CPU speed probe. Not via the PMU: touching PMCR_EL0 panicked the Pi at
+ * boot (trapped by the firmware). A chain of 10M dependent adds runs at
+ * 1 add/cycle on Cortex-A76; timed with the generic timer. The first run
+ * measured ~57 MHz (should be 1500-2400), so it runs twice: with IRQ/FIQ
+ * open and masked. Fast when masked = interrupt storm; slow both ways =
+ * clock or cache state. Also callable later (sweet_cpu_probe from C).
+ */
+static uint64_t
+sweet_adds_us(bool masked)
+{
+	/*
+	 * Timed with mach_absolute_time (the kernel's timebase): raw CNTVCT_EL0
+	 * reads here gave 0 and then garbage (2026-11-10 log), so the earlier
+	 * ~57 MHz result is not trustworthy either.
+	 */
+	uint64_t t0, t1, daif, x = 0, n = 10000000, ns = 0;
+	__asm__ volatile ("mrs %0, DAIF" : "=r"(daif));
+	if (masked) {
+		__asm__ volatile ("msr DAIFSet, #3" ::: "memory");
+	}
+	t0 = mach_absolute_time();
+	__asm__ volatile (
+		"1: add %0, %0, #1\n"
+		"   add %0, %0, #1\n"
+		"   add %0, %0, #1\n"
+		"   add %0, %0, #1\n"
+		"   subs %1, %1, #4\n"
+		"   b.ne 1b\n"
+		: "+r"(x), "+r"(n) : : "cc");
+	t1 = mach_absolute_time();
+	__asm__ volatile ("msr DAIF, %0" : : "r"(daif) : "memory");
+	if (t1 > t0) {
+		absolutetime_to_nanoseconds(t1 - t0, &ns);
+	}
+	IOLog("SWEET: cpu probe %s: abs %llu -> %llu, %llu ns, x %llu n %llu\n",
+	    masked ? "masked" : "open", t0, t1, ns, x, n);
+	return ns / 1000;
+}
+
+extern "C" void sweet_cpu_probe(const char *when);
+
+extern "C" void
+sweet_cpu_probe(const char *when)
+{
+	uint64_t open = sweet_adds_us(false), masked = sweet_adds_us(true);
+	IOLog("SWEET: cpu speed (%s): 10M dependent adds %llu us with interrupts (~%llu MHz), "
+	    "%llu us masked (~%llu MHz)\n", when,
+	    open, open ? 10000000ULL / open : 0, masked, masked ? 10000000ULL / masked : 0);
+}
+#endif
