+	kprintf("SWEET GIC: cpu %u interface mask 0x%x IGROUPR0 0x%08x GICC_CTLR 0x%x GICD_CTLR 0x%x\n",
+	    cpu, mask, gic_read32(gicd_base + GICD_IGROUPR), gic_read32(gicc_base + GICC_CTLR),
+	    gic_read32(gicd_base + GICD_CTLR_V2));
