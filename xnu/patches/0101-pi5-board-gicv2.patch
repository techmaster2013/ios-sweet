+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return kHIDUsage_GD_Keyboard; }
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 3; }
+	virtual OSString *getTransport() APPLE_KEXT_OVERRIDE { return OSString::withCString("USB"); }
+};
+OSDefineMetaClassAndStructors(SweetHIDKeyboard, IOHIDEventService);
+
+class SweetHIDPointer : public IOHIDEventService {
+	OSDeclareDefaultStructors(SweetHIDPointer);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void report(int dx, int dy, UInt32 buttons, int wheel, int hwheel);
+protected:
+	virtual UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return kHIDPage_GenericDesktop; }
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return kHIDUsage_GD_Mouse; }
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 4; }
+	virtual OSString *getTransport() APPLE_KEXT_OVERRIDE { return OSString::withCString("USB"); }
+	virtual UInt32 getReportInterval() APPLE_KEXT_OVERRIDE { return 8000; }
+private:
+	UInt32 fButtons;
+};
+OSDefineMetaClassAndStructors(SweetHIDPointer, IOHIDEventService);
+
+static SweetHIDKeyboard *gSweetKeyboard;
+static SweetHIDPointer *gSweetPointer;
+
+bool
+SweetHIDKeyboard::start(IOService *provider)
+{
+	if (!IOHIDEventService::start(provider)) {
+		return false;
+	}
+	/* An external keyboard: iPadOS hides the on-screen keyboard for it. */
+	setProperty(kIOHIDBuiltInKey, kOSBooleanFalse);
+	gSweetKeyboard = this;
+	registerService();
+	IOLog("SWEET HID: keyboard registered\n");
+	return true;
+}
+
+void
+SweetHIDKeyboard::key(UInt32 page, UInt32 usage, bool down)
+{
+	IOHIDEvent *event = IOHIDEvent::keyboardEvent(mach_absolute_time(), page, usage, down);
+	if (event) {
+		dispatchEvent(event);
+		event->release();
+	}
+}
+
+bool
+SweetHIDPointer::start(IOService *provider)
+{
+	if (!IOHIDEventService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOHIDBuiltInKey, kOSBooleanFalse);
+	gSweetPointer = this;
+	registerService();
+	IOLog("SWEET HID: pointer registered\n");
+	return true;
+}
+
+void
+SweetHIDPointer::report(int dx, int dy, UInt32 buttons, int wheel, int hwheel)
+{
+	uint64_t now = mach_absolute_time();
+	if (dx || dy || buttons != fButtons) {
+		IOHIDEvent *event = IOHIDEvent::relativePointerEvent(now, dx, dy, 0, buttons, fButtons);
+		if (event) {
+			dispatchEvent(event);
+			event->release();
+		}
+		fButtons = buttons;
+	}
+	if (wheel || hwheel) {
+		IOHIDEvent *event = IOHIDEvent::scrollEvent(now, hwheel, wheel, 0);
+		if (event) {
+			dispatchEvent(event);
+			event->release();
+		}
+	}
+}
+
+/* page/usage as in the USB HID report (keyboard page 7, consumer page 12). */
+extern "C" void
+sweet_hid_kbd(unsigned page, unsigned usage, int down)
+{
+	if (gSweetKeyboard) {
+		gSweetKeyboard->key(page, usage, down != 0);
+	}
+}
+
+extern "C" void
+sweet_hid_pointer(int dx, int dy, unsigned buttons, int wheel, int hwheel)
+{
+	if (gSweetPointer) {
+		gSweetPointer->report(dx, dy, buttons, wheel, hwheel);
+	}
+}
