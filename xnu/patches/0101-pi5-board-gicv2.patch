+/*
+ * SWEET (Raspberry Pi 5) SD card root device.
+ *
+ * The BCM2712 SD host (brcm,bcm2712-sdhci, a standard SDHCI 3.0 controller at
+ * the ADT /sweet-sd node: reg = <host size cfg size>, absolute physical) is
+ * the one the Pi firmware loaded this kernel through. This driver
+ * re-initialises the card from CMD0 at 400 kHz, brings it to 4-bit 25 MHz
+ * default speed and moves data with polled PIO through the buffer data port
+ * (no DMA, no interrupts), one command at a time.
+ *
+ * Signalling voltage is left as the firmware set it: a card the firmware
+ * switched to 1.8 V stays at 1.8 V until power-cycled (CMD0 does not undo
+ * it), so the host's 1.8 V enable is kept; only the UHS timing mode is reset
+ * to SDR12, which default-speed operation at 25 MHz uses at either voltage.
+ *
+ * It finds one MBR partition (boot-arg sdpart=1..4, else the first of type
+ * 0xAF, HFS+) and exposes it as the BSD disk sdroot0 (rsdroot0). Root on it
+ * with rd=sdroot0. Writes are refused unless boot-arg sdrw=1, and every write
+ * is checked against the partition bounds right before it is issued.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern int hz;
+/* Console ring (bsd/dev/sweet_ufs.c, fed by _cnputs). */
+extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+extern uint64_t sweet_log_position(void);
+static void sweet_sd_log_start(void);
+extern void sweet_xhci_start(void);
+#if defined(SWEET_BOARD_PI5) && SWEET_BOARD_PI5
+extern void sweet_wifi_start(void);
+extern void sweet_cpu_probe(const char *when);
+#endif
+
+/* SDHCI registers, all accessed as aligned 32-bit words. */
+#define SD_BLK          0x04    /* [11:0] block size, [31:16] block count */
+#define SD_ARG          0x08
+#define SD_XFER         0x0c    /* [15:0] transfer mode, [31:16] command */
+#define SD_RESP0        0x10
+#define SD_DATA         0x20
+#define SD_PRESENT      0x24
+#define SD_HOSTCTL      0x28    /* [7:0] host control 1, [15:8] power control */
+#define SD_CLKCTL       0x2c    /* [15:0] clock, [19:16] timeout, [26:24] reset */
+#define SD_INT          0x30    /* [15:0] normal status, [31:16] error status */
+#define SD_INT_EN       0x34
+#define SD_SIG_EN       0x38
+#define SD_CTRL2        0x3c    /* [31:16] host control 2 */
+#define SD_CAPS         0x40
+#define SD_VERSION      0xfc    /* [31:16] host controller version */
+
+#define CFG_CTRL        0x00    /* brcmstb SDIO_CFG_CTRL */
+#define CFG_CD_TEST_EN  (1u << 31)
+#define CFG_CD_TEST_LEV (1u << 30)
+
+#define PRES_CMD_INH    (1u << 0)
+#define PRES_DAT_INH    (1u << 1)
+#define PRES_CARD       (1u << 16)
+#define PRES_DAT0       (1u << 20)
+
+#define INT_CMD_DONE    (1u << 0)
+#define INT_XFER_DONE   (1u << 1)
+#define INT_BUF_WR      (1u << 4)
+#define INT_BUF_RD      (1u << 5)
+#define INT_ERR         (1u << 15)
+
+#define CLK_INT_EN      (1u << 0)
+#define CLK_INT_STABLE  (1u << 1)
+#define CLK_CARD_EN     (1u << 2)
+#define RST_ALL         (1u << 24)
+#define RST_CMD         (1u << 25)
+#define RST_DAT         (1u << 26)
+
+#define HC1_4BIT        (1u << 1)
+#define HC2_1V8         (1u << (16 + 3))
+
+/* Command register flags: response type, CRC/index checks, data present. */
+#define R_NONE          0x00
+#define R_R2            0x09
+#define R_R3            0x02
+#define R_R1            0x1a    /* also R6, R7 */
+#define R_R1B           0x1b
+#define F_DATA          0x20
+
+/* Transfer mode */
+#define TM_BLKCNT       (1u << 1)
+#define TM_ACMD12       (1u << 2)
+#define TM_READ         (1u << 4)
+#define TM_MULTI        (1u << 5)
+
+#define SD_BLOCK        512u
+#define SD_MAX_BLOCKS   2048u                   /* per command: 1 MiB */
+#define SD_TIMEOUT_NS   (2ull * NSEC_PER_SEC)
+
+static struct {
+	vm_offset_t regs, cfg;
+	uint32_t base_hz;
+	uint32_t rca;
+	bool ccs;                               /* block (not byte) addressed */
+	uint64_t card_blocks;                   /* from the CSD, 0 if unknown */
+	uint64_t first_block, nblocks;          /* partition, in 512-byte blocks */
+	uint64_t log_first, log_nblocks;        /* console log partition (MBR type 0xDA) */
+	uint32_t secsize;                       /* logical sector size for the BSD layer */
+	bool writable;                          /* boot-arg sdrw=1 */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+} sd;
+
+static LCK_GRP_DECLARE(sweet_sd_grp, "sweet_sd");
+static LCK_MTX_DECLARE(sweet_sd_lock, &sweet_sd_grp);
+
+static inline uint32_t
+sd_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(sd.regs + off);
+}
+
+static inline void
+sd_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(sd.regs + off) = v;
+}
+
+static uint64_t
+sd_deadline(void)
+{
+	uint64_t t;
+	nanoseconds_to_absolutetime(SD_TIMEOUT_NS, &t);
+	return mach_absolute_time() + t;
+}
+
+/* Wait until (reg & mask) == want. */
+static int
+sd_wait(uint32_t off, uint32_t mask, uint32_t want)
+{
+	uint64_t deadline = sd_deadline();
+	while ((sd_rd(off) & mask) != want) {
+		if (mach_absolute_time() > deadline) {
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	return 0;
+}
+
+static void
+sd_reset(uint32_t bits)
+{
+	sd_wr(SD_CLKCTL, sd_rd(SD_CLKCTL) | bits);
+	if (sd_wait(SD_CLKCTL, bits, 0)) {
+		printf("SWEET SD: reset 0x%x did not complete\n", bits);
+	}
+}
+
+/* Wait for any of the status bits in want (or an error), then ack them. */
+static int
+sd_wait_int(uint32_t want, const char *what, uint32_t cmd)
+{
+	uint64_t deadline = sd_deadline();
+	uint32_t st;
+	while (!((st = sd_rd(SD_INT)) & (want | INT_ERR))) {
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET SD: CMD%u %s timed out (status 0x%x present 0x%x)\n",
+			    cmd, what, st, sd_rd(SD_PRESENT));
+			sd_reset(RST_CMD | RST_DAT);
+			return ETIMEDOUT;
+		}
+	}
+	if (st & INT_ERR) {
+		printf("SWEET SD: CMD%u %s error 0x%04x (present 0x%x)\n",
+		    cmd, what, st >> 16, sd_rd(SD_PRESENT));
+		sd_wr(SD_INT, st);
+		sd_reset(RST_CMD | RST_DAT);
+		return EIO;
+	}
+	sd_wr(SD_INT, st & want);
+	return 0;
+}
+
+/*
+ * Issue one command. For data commands the caller then moves the blocks
+ * through SD_DATA. resp (4 words, may be NULL) receives the response.
+ */
+static uint32_t sd_blksz = SD_BLOCK;    /* data block size of the next command */
+
+static int
+sd_cmd(uint32_t idx, uint32_t arg, uint32_t flags, uint32_t mode, uint32_t blocks,
+    uint32_t resp[4])
+{
+	uint32_t inhibit = PRES_CMD_INH | ((flags & F_DATA) || flags == R_R1B ? PRES_DAT_INH : 0);
+	if (sd_wait(SD_PRESENT, inhibit, 0)) {
+		printf("SWEET SD: CMD%u: line busy (present 0x%x)\n", idx, sd_rd(SD_PRESENT));
+		sd_reset(RST_CMD | RST_DAT);
+		return ETIMEDOUT;
+	}
+	sd_wr(SD_INT, 0xffffffff);
+	if (flags & F_DATA) {
+		sd_wr(SD_BLK, sd_blksz | (blocks << 16));
+	}
+	sd_wr(SD_ARG, arg);
+	sd_wr(SD_XFER, mode | ((idx << 8 | flags) << 16));
+	int error = sd_wait_int(INT_CMD_DONE, "command", idx);
+	if (error) {
+		return error;
+	}
+	if (resp) {
+		for (int i = 0; i < 4; i++) {
+			resp[i] = sd_rd(SD_RESP0 + 4 * i);
+		}
+	}
+	if (flags == R_R1B) {
+		error = sd_wait_int(INT_XFER_DONE, "busy", idx);
+	}
+	return error;
+}
+
+static int
+sd_acmd(uint32_t idx, uint32_t arg, uint32_t flags, uint32_t resp[4])
+{
+	int error = sd_cmd(55, sd.rca << 16, R_R1, 0, 0, NULL);
+	return error ? error : sd_cmd(idx, arg, flags, 0, 0, resp);
+}
+
+static int
+sd_set_clock(uint32_t hz)
+{
+	uint32_t c = sd_rd(SD_CLKCTL) & ~0x000fffffu;
+	sd_wr(SD_CLKCTL, c);                    /* stop the clock */
+	uint32_t div = 0;
+	if (sd.base_hz > hz) {
+		div = (sd.base_hz + 2 * hz - 1) / (2 * hz);
+		div = MIN(div, 1023u);
+	}
+	c |= (div & 0xff) << 8 | ((div >> 8) & 3) << 6 | 0xeu << 16 | CLK_INT_EN;
+	sd_wr(SD_CLKCTL, c);
+	if (sd_wait(SD_CLKCTL, CLK_INT_STABLE, CLK_INT_STABLE)) {
+		printf("SWEET SD: clock did not stabilise\n");
+		return ETIMEDOUT;
+	}
+	sd_wr(SD_CLKCTL, sd_rd(SD_CLKCTL) | CLK_CARD_EN);
+	delay(2000);
+	printf("SWEET SD: card clock %u kHz (divider %u)\n",
+	    div ? sd.base_hz / (2 * div) / 1000 : sd.base_hz / 1000, div);
+	return 0;
+}
+
+/* PIO: n blocks (n >= 1) between the card and buf, which may be unaligned. */
+static int
+sd_xfer(uint64_t lba, uint32_t n, uint8_t *buf, bool write)
+{
+	uint32_t addr = (uint32_t)(sd.ccs ? lba : lba * SD_BLOCK);
+	uint32_t mode = (write ? 0 : TM_READ) | (n > 1 ? TM_MULTI | TM_BLKCNT | TM_ACMD12 : 0);
+	uint32_t idx = write ? (n > 1 ? 25 : 24) : (n > 1 ? 18 : 17);
+
+	if ((!sd.ccs && lba * SD_BLOCK > UINT32_MAX) || lba > UINT32_MAX) {
+		return EINVAL;
+	}
+	int error = sd_cmd(idx, addr, R_R1 | F_DATA, mode, n, NULL);
+	if (error) {
+		return error;
+	}
+	for (uint32_t b = 0; b < n; b++) {
+		error = sd_wait_int(write ? INT_BUF_WR : INT_BUF_RD, "data", idx);
+		if (error) {
+			return error;
+		}
+		uint8_t *p = buf + (size_t)b * SD_BLOCK;
+		for (uint32_t i = 0; i < SD_BLOCK; i += 4) {
+			uint32_t w;
+			if (write) {
+				memcpy(&w, p + i, 4);
+				sd_wr(SD_DATA, w);
+			} else {
+				w = sd_rd(SD_DATA);
+				memcpy(p + i, &w, 4);
+			}
+		}
+	}
+	/* For writes this also covers the card's programming busy. */
+	return sd_wait_int(INT_XFER_DONE, "transfer", idx);
+}
+
+static int
+sd_read(uint64_t lba, uint32_t n, uint8_t *buf)
+{
+	return sd_xfer(lba, n, buf, false);
+}
+
+/* The only place data goes to the card: inside the partition, or nothing. */
+static int
+sd_write(uint64_t lba, uint32_t n, uint8_t *buf)
+{
+	if (!sd.writable || !sd.nblocks || n == 0 || lba < sd.first_block ||
+	    lba - sd.first_block >= sd.nblocks || n > sd.nblocks - (lba - sd.first_block)) {
+		printf("SWEET SD: refusing write of %u blocks at 0x%llx\n", n, lba);
+		return EPERM;
+	}
+	return sd_xfer(lba, n, buf, true);
+}
+
+/*
+ * High Speed (50 MHz, 3.3 V): CMD6 SWITCH_FUNC mode 1, group 1 function 1,
+ * read the 64-byte status; the card switched if the group 1 result (status
+ * bits 379:376 = low nibble of byte 16) reads 1.
+ */
+static int
+sd_switch_hs(void)
+{
+	uint8_t st[64];
+	int error;
+
+	sd_blksz = 64;
+	error = sd_cmd(6, 0x80fffff1, R_R1 | F_DATA, TM_READ, 1, NULL);
+	if (!error) {
+		error = sd_wait_int(INT_BUF_RD, "data", 6);
+	}
+	if (!error) {
+		for (uint32_t i = 0; i < sizeof(st); i += 4) {
+			uint32_t w = sd_rd(SD_DATA);
+			memcpy(st + i, &w, 4);
+		}
+		error = sd_wait_int(INT_XFER_DONE, "transfer", 6);
+	}
+	sd_blksz = SD_BLOCK;
+	if (error) {
+		return error;
+	}
+	if ((st[16] & 0xf) != 1) {
+		printf("SWEET SD: card did not switch to high speed (group 1 result 0x%x, support 0x%02x%02x)\n",
+		    st[16] & 0xf, st[12], st[13]);
+		return ENOTSUP;
+	}
+	delay(1000);
+	return 0;
+}
+
+static int
+sd_card_init(void)
+{
+	uint32_t r[4];
+	int error;
+
+	uint32_t present = sd_rd(SD_PRESENT), caps = sd_rd(SD_CAPS);
+	printf("SWEET SD: SDHCI version 0x%x caps 0x%x present 0x%x hostctl 0x%x clk 0x%x ctrl2 0x%x cfg 0x%x\n",
+	    sd_rd(SD_VERSION) >> 16, caps, present, sd_rd(SD_HOSTCTL), sd_rd(SD_CLKCTL),
+	    sd_rd(SD_CTRL2) >> 16, sd.cfg ? *(volatile uint32_t *)(sd.cfg + CFG_CTRL) : 0);
+	sd.base_hz = ((caps >> 8) & 0xff) * 1000000u;
+	if (!sd.base_hz) {
+		sd.base_hz = 200000000u;        /* the Pi 5 emmc2 clock */
+	}
+	PE_parse_boot_argn("sdbase", &sd.base_hz, sizeof(sd.base_hz));
+
+	/*
+	 * The Pi 5 card-detect pin is a GPIO, not the host's: force "inserted",
+	 * first through the brcmstb config block, then the SDHCI test bits.
+	 */
+	if (!(present & PRES_CARD) && sd.cfg) {
+		volatile uint32_t *cfg = (volatile uint32_t *)(sd.cfg + CFG_CTRL);
+		*cfg |= CFG_CD_TEST_EN | CFG_CD_TEST_LEV;
+		delay(1000);
+		present = sd_rd(SD_PRESENT);
+	}
+	if (!(present & PRES_CARD)) {
+		sd_wr(SD_HOSTCTL, sd_rd(SD_HOSTCTL) | (3u << 6));
+		delay(1000);
+		present = sd_rd(SD_PRESENT);
+	}
+	printf("SWEET SD: present 0x%x (card %s)\n", present, present & PRES_CARD ? "detected" : "NOT detected");
+
+	sd_reset(RST_CMD | RST_DAT);
+	uint32_t hc = sd_rd(SD_HOSTCTL);
+	if (!(hc & (1u << 8))) {
+		hc = (hc & ~0xff00u) | (0x0fu << 8);    /* 3.3 V, bus power on */
+		sd_wr(SD_HOSTCTL, hc);
+		delay(20000);
+	}
+	sd_wr(SD_HOSTCTL, hc & ~0x3eu);         /* 1-bit, normal speed, no DMA */
+	uint32_t c2 = sd_rd(SD_CTRL2);
+	bool v18 = (c2 & HC2_1V8) != 0;
+	/* UHS mode SDR12, no tuning, no preset values; keep the signalling voltage. */
+	sd_wr(SD_CTRL2, c2 & ~((7u << 16) | (3u << 22) | (1u << 31)));
+	sd_wr(SD_INT_EN, 0xffff00ffu);
+	sd_wr(SD_SIG_EN, 0);
+	sd_wr(SD_INT, 0xffffffff);
+
+	if ((error = sd_set_clock(400000))) {
+		return error;
+	}
+
+	sd.rca = 0;
+	sd_cmd(0, 0, R_NONE, 0, 0, NULL);       /* GO_IDLE_STATE */
+	delay(2000);
+	bool v2 = sd_cmd(8, 0x1aa, R_R1, 0, 0, r) == 0 && (r[0] & 0xfff) == 0x1aa;
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(2 * NSEC_PER_SEC, &deadline);
+	deadline += mach_absolute_time();
+	do {
+		error = sd_acmd(41, (v2 ? 1u << 30 : 0) | 0x00ff8000u, R_R3, r);
+		if (error) {
+			return error;
+		}
+		if (r[0] & (1u << 31)) {
+			break;
+		}
+		delay(10000);
+	} while (mach_absolute_time() < deadline);
+	if (!(r[0] & (1u << 31))) {
+		printf("SWEET SD: card never left power-up (OCR 0x%x)\n", r[0]);
+		return ETIMEDOUT;
+	}
+	sd.ccs = (r[0] >> 30) & 1;
+	printf("SWEET SD: OCR 0x%08x (%s, %s signalling)\n", r[0],
+	    sd.ccs ? "SDHC/SDXC" : "SDSC", v18 ? "1.8 V" : "3.3 V");
+
+	if ((error = sd_cmd(2, 0, R_R2, 0, 0, r))) {          /* ALL_SEND_CID */
+		return error;
+	}
+	/* CID bits [127:8] are in RESP[119:0]: product name [103:64] at RESP[95:56]. */
+	char pnm[6] = {
+		(char)(r[2] >> 24), (char)(r[2] >> 16), (char)(r[2] >> 8),
+		(char)(r[2] >> 0), (char)(r[1] >> 24), 0
+	};
+	for (int i = 0; i < 5; i++) {
+		if (pnm[i] < 0x20 || pnm[i] > 0x7e) {
+			pnm[i] = '?';
+		}
+	}
+	if ((error = sd_cmd(3, 0, R_R1, 0, 0, r))) {          /* SEND_RELATIVE_ADDR */
+		return error;
+	}
+	sd.rca = r[0] >> 16;
+	if ((error = sd_cmd(9, sd.rca << 16, R_R2, 0, 0, r))) { /* SEND_CSD */
+		return error;
+	}
+	if (((r[3] >> 22) & 3) == 1) {          /* CSD version 2: C_SIZE in [69:48] */
+		sd.card_blocks = ((uint64_t)((r[1] >> 8) & 0x3fffff) + 1) * 1024;
+	}
+	printf("SWEET SD: card \"%s\" rca 0x%x, %llu MiB\n", pnm, sd.rca, sd.card_blocks >> 11);
+	if ((error = sd_cmd(7, sd.rca << 16, R_R1B, 0, 0, NULL))) {     /* SELECT_CARD */
+		return error;
+	}
+	if ((error = sd_acmd(6, 2, R_R1, NULL))) {               /* 4-bit bus */
+		return error;
+	}
+	sd_wr(SD_HOSTCTL, sd_rd(SD_HOSTCTL) | HC1_4BIT);
+	if ((error = sd_cmd(16, SD_BLOCK, R_R1, 0, 0, NULL))) {
+		return error;
+	}
+	uint32_t hz = 25000000, max = 25000000, hs = 1;
+	PE_parse_boot_argn("sdhs", &hs, sizeof(hs));
+	if (hs && sd_switch_hs() == 0) {
+		sd_wr(SD_HOSTCTL, sd_rd(SD_HOSTCTL) | (1u << 2));       /* host high speed enable */
+		hz = max = 50000000;
+		printf("SWEET SD: high speed mode (50 MHz)\n");
+	} else if (hs) {
+		printf("SWEET SD: staying at default speed (25 MHz)\n");
+	}
+	PE_parse_boot_argn("sdclk", &hz, sizeof(hz));
+	return sd_set_clock(MIN(hz, max));
+}
+
+static int
+sd_find_partition(void)
+{
+	static uint8_t b[SD_BLOCK];
+	int error = sd_read(0, 1, b);
+	if (error) {
+		return error;
+	}
+	if (b[510] != 0x55 || b[511] != 0xaa) {
+		printf("SWEET SD: no MBR on the card\n");
+		return ENXIO;
+	}
+	uint32_t want = 0;
+	PE_parse_boot_argn("sdpart", &want, sizeof(want));
+	int pick = -1;
+	for (int i = 0; i < 4; i++) {
+		const uint8_t *e = b + 446 + 16 * i;
+		uint32_t start, count;
+		memcpy(&start, e + 8, 4);
+		memcpy(&count, e + 12, 4);
+		printf("SWEET SD: MBR partition %d: type 0x%02x, start %u, %u MiB\n",
+		    i + 1, e[4], start, count >> 11);
+		if (pick < 0 && count && (want ? (uint32_t)i + 1 == want : e[4] == 0xaf)) {
+			pick = i;
+			sd.first_block = start;
+			sd.nblocks = count;
+		}
+		if (e[4] == 0xda && !sd.log_nblocks && count &&
+		    (!sd.card_blocks || (uint64_t)start + count <= sd.card_blocks)) {
+			sd.log_first = start;
+			sd.log_nblocks = count;
+		}
+	}
+	if (pick < 0) {
+		printf("SWEET SD: no %s partition\n", want ? "sdpart=" : "type 0xAF (HFS+)");
+		return ENOENT;
+	}
+	if (sd.card_blocks && sd.first_block + sd.nblocks > sd.card_blocks) {
+		printf("SWEET SD: partition %d runs past the end of the card\n", pick + 1);
+		return ENXIO;
+	}
+	/* HFS+ volume header at byte 1024: signature "H+" or "HX". */
+	if ((error = sd_read(sd.first_block + 2, 1, b))) {
+		return error;
+	}
+	printf("SWEET SD: partition %d volume signature %c%c\n", pick + 1,
+	    b[0] >= 0x20 && b[0] < 0x7f ? b[0] : '?', b[1] >= 0x20 && b[1] < 0x7f ? b[1] : '?');
+	return 0;
+}
+
+static int
+sweet_sd_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!sd.ready) {
+		return ENXIO;
+	}
+	return ((flags & FWRITE) && !sd.writable) ? EROFS : 0;
+}
+
+static int
+sweet_sd_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+sweet_sd_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * sd.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = sd.nblocks * SD_BLOCK;
+	bool rd = buf_flags(bp) & B_READ;
+
+	buf_setresid(bp, count);
+	if (!rd && !sd.writable) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off || (off | count) % SD_BLOCK) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+	lck_mtx_lock(&sweet_sd_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint32_t n = MIN((count - done) / SD_BLOCK, SD_MAX_BLOCKS);
+		uint64_t lba = sd.first_block + (off + done) / SD_BLOCK;
+		error = rd ? sd_read(lba, n, (uint8_t *)vaddr + done) :
+		    sd_write(lba, n, (uint8_t *)vaddr + done);
+		if (error) {
+			break;
+		}
+		done += n * SD_BLOCK;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&sweet_sd_lock);
+	buf_unmap(bp);
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+sweet_sd_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = sd.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > 4096 || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		sd.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = SD_BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = sd.nblocks * SD_BLOCK / sd.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = sd.writable;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE:
+		return 0;                       /* every write completes on the card */
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = SD_MAX_BLOCKS * SD_BLOCK / sd.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = sd.writable ? SD_MAX_BLOCKS * SD_BLOCK / sd.secsize : 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+sweet_sd_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_sd_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+sweet_sd_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_sd_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+sweet_sd_psize(__unused dev_t dev)
+{
+	return sd.ready ? (int)MIN(sd.nblocks * SD_BLOCK / sd.secsize, INT_MAX) : -1;
+}
+
+static int
+sweet_sd_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(sweet_sd_strategy, NULL, dev, B_READ, minphys, uio, (int)sd.secsize);
+}
+
+static int
+sweet_sd_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (!sd.writable) {
+		return EROFS;
+	}
+	return physio(sweet_sd_strategy, NULL, dev, B_WRITE, minphys, uio, (int)sd.secsize);
+}
+
+static const struct bdevsw sweet_sd_bdevsw = {
+	.d_open     = sweet_sd_open,
+	.d_close    = sweet_sd_close,
+	.d_strategy = sweet_sd_strategy,
+	.d_ioctl    = sweet_sd_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = sweet_sd_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw sweet_sd_cdevsw = {
+	.d_open       = sweet_sd_open,
+	.d_close      = sweet_sd_close,
+	.d_read       = sweet_sd_read,
+	.d_write      = sweet_sd_write,
+	.d_ioctl      = sweet_sd_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+sweet_sd_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-sd", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("SWEET SD: no /sweet-sd node in the device tree\n");
+		return ENXIO;
+	}
+	sd.regs = ml_io_map(reg[0], reg[1]);
+	if (size >= 4 * sizeof(uintptr_t)) {
+		sd.cfg = ml_io_map(reg[2], reg[3]);
+	}
+	uint32_t rw = 0;
+	PE_parse_boot_argn("sdrw", &rw, sizeof(rw));
+	sd.secsize = DEV_BSIZE;
+
+	lck_mtx_lock(&sweet_sd_lock);
+	int error = sd_card_init();
+	if (!error) {
+		error = sd_find_partition();
+	}
+	lck_mtx_unlock(&sweet_sd_lock);
+	if (error) {
+		return error;
+	}
+
+	sd.bmajor = bdevsw_add(-1, &sweet_sd_bdevsw);
+	if (sd.bmajor < 0) {
+		return ENXIO;
+	}
+	sd.cmajor = cdevsw_add_with_bdev(-1, &sweet_sd_cdevsw, sd.bmajor);
+	if (sd.cmajor < 0) {
+		return ENXIO;
+	}
+	sd.bdev = makedev(sd.bmajor, 0);
+	devfs_make_node(sd.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "sdroot0");
+	devfs_make_node(makedev(sd.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rsdroot0");
+	/* Only now, with the partition bounds known, can writes be allowed. */
+	sd.writable = (rw != 0);
+	sd.ready = true;
+	printf("SWEET SD: root partition at block %llu, %llu MiB, %s\n",
+	    sd.first_block, sd.nblocks >> 11, sd.writable ? "read-write" : "read-only");
+	sweet_sd_log_start();
+	sweet_xhci_start();             /* USB keyboard/mouse (bsd/dev/sweet_xhci.c) */
+#if defined(SWEET_BOARD_PI5) && SWEET_BOARD_PI5
+	sweet_wifi_start();             /* CYW43455 over SDIO (bsd/dev/sweet_wifi.c) */
+#endif
+	return 0;
+}
+
+/*
+ * Persistent console log on the SD card. The console ring kept by
+ * sweet_ufs.c (every _cnputs byte: kernel printf and daemons' /dev/console)
+ * is copied every sdlogsecs seconds (default 2) to the MBR partition of type
+ * 0xDA, in the phone's format (tools/sweet-log.py): bytes [0, 4096) a header
+ *   "SWEETLOG" | u32 version 1 | u32 ring size | u64 total bytes | u64 flush seq
+ * then the 4 MiB ring, console byte n at ring offset n % size. Only that
+ * partition is ever written here (sd_log_write). Disabled with sdlog=0.
+ */
+#define SDLOG_RING      (4u << 20)
+#define SDLOG_HDR       (4096u / SD_BLOCK)
+#define SDLOG_BLOCKS    (SDLOG_HDR + SDLOG_RING / SD_BLOCK)
+#define SDLOG_CHUNK     (64u << 10)
+
+static uint8_t sdlog_buf[SDLOG_CHUNK];
+static int sdlog_chan;
+static uint32_t sdlog_secs = 2;
+
+static int
+sd_log_write(uint64_t rel, uint32_t n, uint8_t *buf)
+{
+	if (!sd.log_nblocks || n == 0 || rel >= SDLOG_BLOCKS || n > SDLOG_BLOCKS - rel ||
+	    SDLOG_BLOCKS > sd.log_nblocks) {
+		printf("SWEET SD: refusing log write of %u blocks at +%llu\n", n, rel);
+		return EPERM;
+	}
+	return sd_xfer(sd.log_first + rel, n, buf, true);
+}
+
+static void
+sweet_sd_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t flushed = 0, seq = 0;
+
+	printf("SWEET SD LOG: console log to partition at block %llu every %u s\n",
+	    sd.log_first, sdlog_secs);
+	uint32_t ticks = 0;
+	for (;;) {
+		(void)tsleep(&sdlog_chan, PZERO, "sdlog", hz * (int)sdlog_secs);
+#if defined(SWEET_BOARD_PI5) && SWEET_BOARD_PI5
+		/* CPU speed again once userland is busy (see SweetPlatformExpert.cpp). */
+		ticks++;
+		if (ticks * sdlog_secs == 30) {
+			sweet_cpu_probe("30 s after root");
+		} else if (ticks * sdlog_secs == 120) {
+			sweet_cpu_probe("120 s after root");
+		}
+#endif
+		uint64_t total = sweet_log_position();
+		if (total == flushed) {
+			continue;
+		}
+		/* Rewrite from the start of the sector holding the first new byte. */
+		uint64_t pos = flushed & ~(uint64_t)(SD_BLOCK - 1);
+		if (total - pos > SDLOG_RING) {
+			pos = (total - SDLOG_RING + SD_BLOCK - 1) & ~(uint64_t)(SD_BLOCK - 1);
+		}
+		int error = 0;
+		lck_mtx_lock(&sweet_sd_lock);
+		while (pos < total && !error) {
+			uint32_t off = (uint32_t)(pos % SDLOG_RING);
+			uint32_t want = (uint32_t)MIN(MIN(total - pos, (uint64_t)SDLOG_CHUNK),
+			    (uint64_t)(SDLOG_RING - off));
+			uint64_t p = pos;
+			uint32_t got = sweet_log_copy(&p, (char *)sdlog_buf, want);
+			if (p - got != pos) {
+				/* Fell a whole ring behind: restart at a sector boundary. */
+				pos = (p - got + SD_BLOCK - 1) & ~(uint64_t)(SD_BLOCK - 1);
+				continue;
+			}
+			if (got == 0) {
+				break;
+			}
+			uint32_t blocks = (got + SD_BLOCK - 1) / SD_BLOCK;
+			bzero(sdlog_buf + got, blocks * SD_BLOCK - got);
+			error = sd_log_write(SDLOG_HDR + off / SD_BLOCK, blocks, sdlog_buf);
+			pos += got;
+		}
+		if (!error) {
+			struct {
+				char magic[8];
+				uint32_t version, size;
+				uint64_t total, seq;
+			} h = {
+				.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+				.version = 1, .size = SDLOG_RING, .total = total, .seq = ++seq,
+			};
+			bzero(sdlog_buf, SD_BLOCK);
+			memcpy(sdlog_buf, &h, sizeof(h));
+			error = sd_log_write(0, 1, sdlog_buf);
+		}
+		lck_mtx_unlock(&sweet_sd_lock);
+		if (error) {
+			printf("SWEET SD LOG: write failed (%d), stopping\n", error);
+			return;
+		}
+		flushed = total;
+	}
+}
+
+static void
+sweet_sd_log_start(void)
+{
+	uint32_t on = 1;
+	thread_t thread;
+
+	PE_parse_boot_argn("sdlog", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	if (sd.log_nblocks < SDLOG_BLOCKS) {
+		printf("SWEET SD LOG: no log partition (MBR type 0xDA, >= %u KiB)\n",
+		    SDLOG_BLOCKS / 2);
+		return;
+	}
+	PE_parse_boot_argn("sdlogsecs", &sdlog_secs, sizeof(sdlog_secs));
+	if (sdlog_secs == 0 || sdlog_secs > 60) {
+		sdlog_secs = 2;
+	}
+	if (kernel_thread_start(sweet_sd_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* Root device for rd=sdroot0 (IOFindBSDRoot). */
+int sweet_sd_rootdev(dev_t *dev);
+
+int
+sweet_sd_rootdev(dev_t *dev)
+{
+	if (!sd.ready) {
+		int error = sweet_sd_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = sd.bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 6b926fe..7ed5036 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -691,12 +691,35 @@ void sweet_log_append(const char *c, int size);
 void
 sweet_log_append(const char *c, int size)
 {
-	if (size <= 0) {
-		return;
-	}
-	uint64_t at = os_atomic_add_orig(&sweet_log_total, (uint64_t)size, relaxed);
-	for (int i = 0; i < size; i++) {
-		sweet_log_ring[(at + (uint64_t)i) % SWEET_LOG_SIZE] = c[i];
+	/*
+	 * Every line starts with the time since boot, "[ssss.mmm] ", to find
+	 * where boot time goes (Pi 5). Line starts are tracked loosely: two
+	 * writers at once can share a prefix, which is fine for a log.
+	 */
+	static bool line_start = true;
+	char buf[320];
+
+	while (size > 0) {
+		int n = 0;
+		while (size > 0 && n < (int)sizeof(buf) - 24) {
+			if (line_start) {
+				uint64_t ns;
+				absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+				n += snprintf(buf + n, sizeof(buf) - n, "[%4llu.%03llu] ",
+				    ns / NSEC_PER_SEC, (ns / NSEC_PER_MSEC) % 1000);
+				line_start = false;
+			}
+			buf[n++] = *c;
+			if (*c == '\n') {
+				line_start = true;
+			}
+			c++;
+			size--;
+		}
+		uint64_t at = os_atomic_add_orig(&sweet_log_total, (uint64_t)n, relaxed);
+		for (int i = 0; i < n; i++) {
+			sweet_log_ring[(at + (uint64_t)i) % SWEET_LOG_SIZE] = buf[i];
+		}
 	}
 }
 
diff --git a/bsd/dev/sweet_wifi.c b/bsd/dev/sweet_wifi.c
new file mode 100644
index 0000000..10b03e7
--- /dev/null
+++ b/bsd/dev/sweet_wifi.c
@@ -0,0 +1,505 @@
+/*
+ * SWEET (Raspberry Pi 5) Wi-Fi, step 1: bring up the CYW43455 over SDIO and
+ * read its chip ID. No network yet.
+ *
+ * Hardware (bcm2712-rpi-5-b.dtb):
+ *  - SDIO host /axi/mmc@1100000, brcm,bcm2712-sdhci (standard SDHCI):
+ *    host regs PA 0x1001100000 (+0x260), brcmstb cfg PA 0x1001100400.
+ *  - WL_ON = GPIO 28 of the brcmstb GPIO block at PA 0x107d508500 (bank 0:
+ *    DATA +0x04, IODIR +0x08 with 1 = input), active high, 150 ms start-up.
+ *  - SDIO pins 30..35 (clk, cmd, d0..d3) muxed to "sd2" by the pinctrl at
+ *    PA 0x107d504100 (4 bits per pin, 8 pins per word). The firmware may or
+ *    may not have set them: the driver logs what it finds, and boot-arg
+ *    wifimux=N (1..8) writes alt function N for pins 30..35 if they are on
+ *    function 0 (GPIO). Without a working mux CMD5 simply times out.
+ *
+ * Polled PIO, CMD52 (single byte) only. Off unless boot-arg wifi=1: the
+ * first version panicked the Pi within seconds of the root mount, before the
+ * SD log was saved. So the thread waits 15 s, and before each first touch of
+ * a register block it logs a STEP line and sleeps 3 s (the SD log is saved
+ * every 2 s): the last STEP in the log names the access that kills it.
+ * Output: "SWEET WIFI: chip 0x4345 rev N" when the chip answers.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) && defined(SWEET_BOARD_PI5) && SWEET_BOARD_PI5
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <sys/proc.h>
+
+extern int hz;
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+
+#define WF_HOST_PA      0x1001100000ull
+#define WF_CFG_PA       0x1001100400ull
+#define GIO_PA          0x107d508500ull
+#define PINCTRL_PA      0x107d504100ull
+#define WL_ON_PIN       28u
+
+/* SDHCI registers (same layout as bsd/dev/sweet_sd.c). */
+#define H_BLK           0x04
+#define H_ARG           0x08
+#define H_XFER          0x0c
+#define H_RESP0         0x10
+#define H_PRESENT       0x24
+#define H_HOSTCTL       0x28    /* [7:0] host control 1, [15:8] power control */
+#define H_CLKCTL        0x2c
+#define H_INT           0x30
+#define H_INT_EN        0x34
+#define H_SIG_EN        0x38
+#define H_CTRL2         0x3c
+#define H_CAPS          0x40
+#define H_VERSION       0xfc
+
+#define PRES_CMD_INH    (1u << 0)
+#define PRES_DAT_INH    (1u << 1)
+#define INT_CMD_DONE    (1u << 0)
+#define INT_ERR         (1u << 15)
+#define CLK_INT_EN      (1u << 0)
+#define CLK_INT_STABLE  (1u << 1)
+#define CLK_CARD_EN     (1u << 2)
+#define RST_ALL         (1u << 24)
+#define RST_CMD         (1u << 25)
+#define RST_DAT         (1u << 26)
+#define HC1_4BIT        (1u << 1)
+
+#define R_NONE          0x00
+#define R_R3            0x02    /* 48-bit, no CRC / index check: R4 */
+#define R_R1            0x1a    /* R1, R5, R6 */
+#define R_R1B           0x1b
+
+/* SDIO / Broadcom function 1 registers. */
+#define CCCR_REV        0x00
+#define CCCR_IOEN       0x02
+#define CCCR_IORDY      0x03
+#define CCCR_BUSIF      0x07
+#define CCCR_CAPS       0x08
+#define F1_SBADDR_LOW   0x1000a
+#define F1_SBADDR_MID   0x1000b
+#define F1_SBADDR_HIGH  0x1000c
+#define F1_CHIPCLKCSR   0x1000e
+#define CLK_ALP_REQ     0x08
+#define CLK_HW_REQ_OFF  0x20
+#define CLK_ALP_AVAIL   0x40
+#define SB_ACCESS_4B    0x8000
+#define CHIPCOMMON      0x18000000u
+
+static struct {
+	vm_offset_t regs, cfg, gio, pinctrl;
+	uint32_t base_hz;
+	uint32_t rca;
+} wf;
+
+static int wf_chan;
+
+static void
+step(const char *what)
+{
+	printf("SWEET WIFI: STEP %s\n", what);
+	(void)tsleep(&wf_chan, PZERO, "wifistep", hz * 3);
+}
+
+static inline uint32_t h_rd(uint32_t o) { return *(volatile uint32_t *)(wf.regs + o); }
+static inline void h_wr(uint32_t o, uint32_t v) { *(volatile uint32_t *)(wf.regs + o) = v; }
+static inline uint32_t g_rd(uint32_t o) { return *(volatile uint32_t *)(wf.gio + o); }
+static inline void g_wr(uint32_t o, uint32_t v) { *(volatile uint32_t *)(wf.gio + o) = v; }
+static inline uint32_t p_rd(uint32_t o) { return *(volatile uint32_t *)(wf.pinctrl + o); }
+static inline void p_wr(uint32_t o, uint32_t v) { *(volatile uint32_t *)(wf.pinctrl + o) = v; }
+
+static int
+h_wait(uint32_t off, uint32_t mask, uint32_t want, uint32_t ms)
+{
+	uint64_t deadline, t;
+	nanoseconds_to_absolutetime((uint64_t)ms * NSEC_PER_MSEC, &t);
+	deadline = mach_absolute_time() + t;
+	while ((h_rd(off) & mask) != want) {
+		if (mach_absolute_time() > deadline) {
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	return 0;
+}
+
+static void
+h_reset(uint32_t bits)
+{
+	h_wr(H_CLKCTL, h_rd(H_CLKCTL) | bits);
+	if (h_wait(H_CLKCTL, bits, 0, 100)) {
+		printf("SWEET WIFI: host reset 0x%x did not complete\n", bits);
+	}
+}
+
+/* One command, no data. quiet: a timeout is expected (probing). */
+static int
+h_cmd(uint32_t idx, uint32_t arg, uint32_t flags, uint32_t *resp, bool quiet)
+{
+	uint32_t inhibit = PRES_CMD_INH | (flags == R_R1B ? PRES_DAT_INH : 0);
+	if (h_wait(H_PRESENT, inhibit, 0, 100)) {
+		printf("SWEET WIFI: CMD%u: line busy (present 0x%x)\n", idx, h_rd(H_PRESENT));
+		h_reset(RST_CMD | RST_DAT);
+		return ETIMEDOUT;
+	}
+	h_wr(H_INT, 0xffffffff);
+	h_wr(H_ARG, arg);
+	h_wr(H_XFER, (idx << 8 | flags) << 16);
+	uint64_t deadline, t;
+	nanoseconds_to_absolutetime(100 * NSEC_PER_MSEC, &t);
+	deadline = mach_absolute_time() + t;
+	uint32_t st;
+	while (!((st = h_rd(H_INT)) & (INT_CMD_DONE | INT_ERR))) {
+		if (mach_absolute_time() > deadline) {
+			if (!quiet) {
+				printf("SWEET WIFI: CMD%u timed out (status 0x%x present 0x%x)\n",
+				    idx, st, h_rd(H_PRESENT));
+			}
+			h_reset(RST_CMD | RST_DAT);
+			return ETIMEDOUT;
+		}
+	}
+	if (st & INT_ERR) {
+		if (!quiet) {
+			printf("SWEET WIFI: CMD%u error 0x%04x (present 0x%x)\n",
+			    idx, st >> 16, h_rd(H_PRESENT));
+		}
+		h_wr(H_INT, st);
+		h_reset(RST_CMD | RST_DAT);
+		return EIO;
+	}
+	h_wr(H_INT, st);
+	if (resp) {
+		*resp = h_rd(H_RESP0);
+	}
+	return 0;
+}
+
+static int
+h_set_clock(uint32_t hz)
+{
+	uint32_t c = h_rd(H_CLKCTL) & ~0x000fffffu;
+	h_wr(H_CLKCTL, c);
+	uint32_t div = 0;
+	if (wf.base_hz > hz) {
+		div = (wf.base_hz + 2 * hz - 1) / (2 * hz);
+		div = MIN(div, 1023u);
+	}
+	c |= (div & 0xff) << 8 | ((div >> 8) & 3) << 6 | 0xeu << 16 | CLK_INT_EN;
+	h_wr(H_CLKCTL, c);
+	if (h_wait(H_CLKCTL, CLK_INT_STABLE, CLK_INT_STABLE, 100)) {
+		printf("SWEET WIFI: clock did not stabilise\n");
+		return ETIMEDOUT;
+	}
+	h_wr(H_CLKCTL, h_rd(H_CLKCTL) | CLK_CARD_EN);
+	delay(2000);
+	printf("SWEET WIFI: SDIO clock %u kHz\n",
+	    div ? wf.base_hz / (2 * div) / 1000 : wf.base_hz / 1000);
+	return 0;
+}
+
+/* CMD52: one byte of function fn at addr. */
+static int
+cmd52(bool write, uint32_t fn, uint32_t addr, uint8_t in, uint8_t *out)
+{
+	uint32_t arg = (write ? 1u << 31 : 0) | (fn & 7) << 28 | (addr & 0x1ffff) << 9 | in;
+	uint32_t r = 0;
+	int error = h_cmd(52, arg, R_R1, &r, false);
+	if (error) {
+		return error;
+	}
+	if (r & 0xcb00) {       /* R5 flags: COM_CRC, ILLEGAL, ERROR, FUNC_NUM, OUT_OF_RANGE */
+		printf("SWEET WIFI: CMD52 %s f%u 0x%x: R5 flags 0x%02x\n",
+		    write ? "write" : "read", fn, addr, (r >> 8) & 0xff);
+		return EIO;
+	}
+	if (out) {
+		*out = (uint8_t)r;
+	}
+	return 0;
+}
+
+static int
+bp_window(uint32_t addr)
+{
+	int e = cmd52(true, 1, F1_SBADDR_LOW, (addr >> 8) & 0x80, NULL);
+	if (!e) {
+		e = cmd52(true, 1, F1_SBADDR_MID, (addr >> 16) & 0xff, NULL);
+	}
+	if (!e) {
+		e = cmd52(true, 1, F1_SBADDR_HIGH, (addr >> 24) & 0xff, NULL);
+	}
+	return e;
+}
+
+/* 32-bit backplane read through the function 1 window, a byte at a time. */
+static int
+bp_read32(uint32_t addr, uint32_t *v)
+{
+	int e = bp_window(addr);
+	uint32_t off = (addr & 0x7fff) | SB_ACCESS_4B;
+	*v = 0;
+	for (int i = 0; i < 4 && !e; i++) {
+		uint8_t b = 0;
+		e = cmd52(false, 1, off + i, 0, &b);
+		*v |= (uint32_t)b << (8 * i);
+	}
+	return e;
+}
+
+static bool wf_pins_ok;         /* pinctrl reads worked */
+
+static void
+pins_setup(void)
+{
+	/*
+	 * Mux words for pins 24..31 (+0x0c) and 32..39 (+0x10). Only the first
+	 * 0x20 bytes: the BCM2712 D0 pinctrl is 0x20 long (C0: 0x30), and the
+	 * old loop to 0x2c is the likely cause of the 2026-11-10 panic. One
+	 * line per register so a fault still leaves the earlier ones in the log.
+	 */
+	step("read pinctrl words 0x00..0x1c @0x107d504100");
+	for (uint32_t o = 0; o < 0x20; o += 4) {
+		printf("SWEET WIFI: pinctrl +0x%02x = 0x%08x\n", o, p_rd(o));
+	}
+	wf_pins_ok = true;
+	uint32_t alt = 0;
+	PE_parse_boot_argn("wifimux", &alt, sizeof(alt));
+	if (alt >= 1 && alt <= 8) {
+		for (uint32_t pin = 30; pin <= 35; pin++) {
+			uint32_t off = (pin / 8) * 4, sh = (pin % 8) * 4;
+			uint32_t v = p_rd(off);
+			if (((v >> sh) & 0xf) == 0) {
+				p_wr(off, (v & ~(0xfu << sh)) | alt << sh);
+			}
+		}
+		printf("SWEET WIFI: wifimux=%u -> mux[24..31] 0x%08x mux[32..39] 0x%08x\n",
+		    alt, p_rd(0x0c), p_rd(0x10));
+	}
+	/* WL_ON (GPIO 28) as GPIO: nibble 4 of mux word 3 must be 0. */
+	uint32_t v = p_rd(0x0c);
+	if ((v >> 16) & 0xf) {
+		step("write pinctrl mux for GPIO 28");
+		printf("SWEET WIFI: GPIO 28 was on function %u, setting GPIO\n", (v >> 16) & 0xf);
+		p_wr(0x0c, v & ~(0xfu << 16));
+	}
+}
+
+static void
+wl_power(void)
+{
+	step("read gio @0x107d508500");
+	printf("SWEET WIFI: gio bank0 data 0x%08x iodir 0x%08x\n", g_rd(0x04), g_rd(0x08));
+	step("drive WL_ON (GPIO 28) low, then high");
+	g_wr(0x04, g_rd(0x04) & ~(1u << WL_ON_PIN));    /* low first: chip reset */
+	g_wr(0x08, g_rd(0x08) & ~(1u << WL_ON_PIN));    /* output */
+	delay(20000);
+	g_wr(0x04, g_rd(0x04) | (1u << WL_ON_PIN));
+	delay(150000);                                  /* wl-on-reg startup-delay-us */
+	printf("SWEET WIFI: WL_ON high (data 0x%08x iodir 0x%08x)\n", g_rd(0x04), g_rd(0x08));
+}
+
+/*
+ * The firmware leaves pins 30..35 off the SDIO host (2026-11-10: CMD5 end-bit
+ * error, CMD/DAT lines low in PRESENT). The alt-function number of "sd2" is
+ * not known here, so try 1..8 on those six pins (they only reach the Wi-Fi
+ * chip on a Pi 5) and keep the first one the chip answers CMD5 on.
+ */
+static int
+cmd5_probe(uint32_t *r)
+{
+	if (h_cmd(5, 0, R_R3, r, true) == 0) {
+		printf("SWEET WIFI: CMD5 answered with the firmware's pin setup\n");
+		return 0;
+	}
+	if (!wf_pins_ok) {
+		return EIO;
+	}
+	uint32_t w3 = p_rd(0x0c), w4 = p_rd(0x10);
+	printf("SWEET WIFI: CMD5 failed (present 0x%08x); probing pin functions, mux 0x%08x 0x%08x\n",
+	    h_rd(H_PRESENT), w3, w4);
+	for (uint32_t alt = 1; alt <= 8; alt++) {
+		uint32_t n3 = (w3 & 0x00ffffffu) | alt << 24 | alt << 28;      /* pins 30, 31 */
+		uint32_t n4 = (w4 & 0xffff0000u) | alt | alt << 4 | alt << 8 | alt << 12; /* 32..35 */
+		p_wr(0x0c, n3);
+		p_wr(0x10, n4);
+		delay(2000);
+		uint32_t pres = h_rd(H_PRESENT);
+		h_cmd(0, 0, R_NONE, NULL, true);
+		delay(2000);
+		int e = h_cmd(5, 0, R_R3, r, true);
+		printf("SWEET WIFI: alt %u: present 0x%08x (CMD %u DAT 0x%x) -> CMD5 %s\n", alt, pres,
+		    (pres >> 24) & 1, (pres >> 20) & 0xf, e ? "no" : "ANSWERED");
+		if (e == 0) {
+			return 0;
+		}
+	}
+	p_wr(0x0c, w3);
+	p_wr(0x10, w4);
+	return EIO;
+}
+
+static int
+sdio_init(void)
+{
+	uint32_t r = 0;
+	int e;
+
+	step("read SDIO host @0x1001100000");
+	printf("SWEET WIFI: SDHCI version 0x%x caps 0x%08x present 0x%08x\n",
+	    h_rd(H_VERSION) >> 16, h_rd(H_CAPS), h_rd(H_PRESENT));
+	step("SDIO host reset");
+	h_reset(RST_ALL);
+	wf.base_hz = ((h_rd(H_CAPS) >> 8) & 0xff) * 1000000u;
+	if (wf.base_hz == 0) {
+		wf.base_hz = 200000000u;        /* clk-emmc2 */
+	}
+	h_wr(H_HOSTCTL, (h_rd(H_HOSTCTL) & ~0xff00u) | (0x7u << 9) | (1u << 8)); /* 3.3 V, bus power */
+	delay(10000);
+	h_wr(H_INT_EN, 0xffffffff);     /* status latches; no interrupt signals */
+	h_wr(H_SIG_EN, 0);
+	if ((e = h_set_clock(400000))) {
+		return e;
+	}
+	h_cmd(0, 0, R_NONE, NULL, true);
+	delay(2000);
+	/* CMD5 with arg 0 asks for the OCR; then repeat with 3.2-3.4 V until ready. */
+	if ((e = cmd5_probe(&r))) {
+		printf("SWEET WIFI: no answer to CMD5 with any pin function\n");
+		return e;
+	}
+	printf("SWEET WIFI: CMD5 OCR 0x%08x (%u function(s))\n", r, (r >> 28) & 7);
+	for (int i = 0; i < 100; i++) {
+		if ((e = h_cmd(5, 0x00300000, R_R3, &r, false))) {
+			return e;
+		}
+		if (r & (1u << 31)) {
+			break;
+		}
+		delay(10000);
+	}
+	if (!(r & (1u << 31))) {
+		printf("SWEET WIFI: card never ready (OCR 0x%08x)\n", r);
+		return ETIMEDOUT;
+	}
+	if ((e = h_cmd(3, 0, R_R1, &r, false))) {
+		return e;
+	}
+	wf.rca = r >> 16;
+	if ((e = h_cmd(7, wf.rca << 16, R_R1B, NULL, false))) {
+		return e;
+	}
+	uint8_t rev = 0, caps = 0;
+	cmd52(false, 0, CCCR_REV, 0, &rev);
+	cmd52(false, 0, CCCR_CAPS, 0, &caps);
+	printf("SWEET WIFI: SDIO card rca 0x%x, CCCR rev 0x%02x caps 0x%02x\n", wf.rca, rev, caps);
+	/* 4-bit bus, 25 MHz. */
+	uint8_t bus = 0;
+	if (!cmd52(false, 0, CCCR_BUSIF, 0, &bus) &&
+	    !cmd52(true, 0, CCCR_BUSIF, (bus & ~3) | 2, NULL)) {
+		h_wr(H_HOSTCTL, h_rd(H_HOSTCTL) | HC1_4BIT);
+	}
+	h_set_clock(25000000);
+	/* Enable function 1 (the backplane) and wait for it. */
+	if ((e = cmd52(true, 0, CCCR_IOEN, 0x02, NULL))) {
+		return e;
+	}
+	uint8_t rdy = 0;
+	for (int i = 0; i < 100 && !(rdy & 0x02); i++) {
+		cmd52(false, 0, CCCR_IORDY, 0, &rdy);
+		delay(10000);
+	}
+	printf("SWEET WIFI: function 1 %s (IORDY 0x%02x)\n", (rdy & 2) ? "ready" : "NOT ready", rdy);
+	return (rdy & 2) ? 0 : ETIMEDOUT;
+}
+
+static int
+chip_id(void)
+{
+	int e = cmd52(true, 1, F1_CHIPCLKCSR, CLK_HW_REQ_OFF | CLK_ALP_REQ, NULL);
+	uint8_t csr = 0;
+	for (int i = 0; i < 100 && !e; i++) {
+		e = cmd52(false, 1, F1_CHIPCLKCSR, 0, &csr);
+		if (csr & CLK_ALP_AVAIL) {
+			break;
+		}
+		delay(1000);
+	}
+	printf("SWEET WIFI: ALP clock %s (csr 0x%02x)\n", (csr & CLK_ALP_AVAIL) ? "up" : "NOT up", csr);
+	uint32_t id = 0;
+	if (e || (e = bp_read32(CHIPCOMMON, &id))) {
+		printf("SWEET WIFI: chip ID read failed (%d)\n", e);
+		return e;
+	}
+	printf("SWEET WIFI: chip 0x%04x rev %u (raw 0x%08x)%s\n", id & 0xffff, (id >> 16) & 0xf, id,
+	    (id & 0xffff) == 0x4345 ? " = CYW43455" : "");
+	return 0;
+}
+
+static void
+sweet_wifi_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	printf("SWEET WIFI: starting in 15 s\n");
+	(void)tsleep(&wf_chan, PZERO, "wifiwait", hz * 15);
+	step("map registers (host, gio, pinctrl)");
+	wf.regs = ml_io_map(WF_HOST_PA, 0x1000);
+	wf.cfg = wf.regs + 0x400;
+	wf.gio = ml_io_map(GIO_PA & ~0xfffull, 0x1000) + (GIO_PA & 0xfff);
+	wf.pinctrl = ml_io_map(PINCTRL_PA & ~0xfffull, 0x1000) + (PINCTRL_PA & 0xfff);
+	if (!wf.regs || !wf.gio || !wf.pinctrl) {
+		printf("SWEET WIFI: cannot map registers\n");
+		return;
+	}
+	/*
+	 * BCM2712 stepping, from the shim (firmware DT pinctrl compatible). The
+	 * sd2 mux values differ: D0 alt 1 on pins 30..35, C0 4,4,4,3,4,3.
+	 */
+	DTEntry dt;
+	uint32_t const *rev = NULL;
+	unsigned int rsz = 0;
+	if (SecureDTLookupEntry(NULL, "/sweet-wifi", &dt) == kSuccess &&
+	    SecureDTGetProperty(dt, "soc-rev", (void const **)&rev, &rsz) == kSuccess && rsz >= 4) {
+		printf("SWEET WIFI: BCM2712 stepping %x (config.txt: %s)\n", *rev,
+		    *rev == 0xd0 ? "gpio=30-35=a1" : *rev == 0xc0 ? "gpio=30-32,34=a4 and gpio=33,35=a3" : "?");
+	}
+	/*
+	 * Pin muxing is needed (CMD/DAT read low without it, 2026-11-10), but
+	 * the pinctrl block faults on its first read from here (2026-11-11), so
+	 * the firmware has to do it (config.txt gpio=). wifipins=1 to try anyway.
+	 */
+	uint32_t pins = 0;
+	PE_parse_boot_argn("wifipins", &pins, sizeof(pins));
+	if (pins) {
+		pins_setup();
+	} else {
+		printf("SWEET WIFI: pinctrl not touched (firmware pin setup; wifipins=1 to try)\n");
+	}
+	wl_power();
+	if (sdio_init() == 0) {
+		chip_id();
+	}
+	/* Returning from the continuation terminates the thread. */
+}
+
+void sweet_wifi_start(void);
+
+void
+sweet_wifi_start(void)
+{
+	uint32_t on = 0;
+	PE_parse_boot_argn("wifi", &on, sizeof(on));
+	if (!on) {
+		printf("SWEET WIFI: off (boot-arg wifi=1 to try it)\n");
+		return;
+	}
+	thread_t t;
+	if (kernel_thread_start(sweet_wifi_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+#endif
