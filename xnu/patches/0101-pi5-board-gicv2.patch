+/*
+ * Shut Down / Restart. Without this the request ends nowhere and IOKit's
+ * watchdog panics "Halt/Restart Timed Out" after the root is already
+ * unmounted. Pi 5: PSCI 1.1 over SMC, as Linux does (SYSTEM_OFF leaves the
+ * board in its halt state, the power button starts it again). Panic restarts
+ * keep the default path so the panic stays on screen.
+ */
+int
+SweetPlatformExpert::haltRestart(unsigned int type)
+{
+#if defined(SWEET_BOARD_PI5) && SWEET_BOARD_PI5
+	uint64_t fn = 0;
+	if (type == kPEHaltCPU || type == kPEUPSDelayHaltCPU) {
+		fn = 0x84000008;        /* PSCI SYSTEM_OFF */
+	} else if (type == kPERestartCPU) {
+		fn = 0x84000009;        /* PSCI SYSTEM_RESET */
+	}
+	if (fn) {
+		IOLog("SWEET: %s via PSCI\n", fn == 0x84000008 ? "power off" : "restart");
+		IODelay(100000);        /* let the console log line out */
+		register uint64_t x0 __asm__("x0") = fn;
+		register uint64_t x1 __asm__("x1") = 0;
+		register uint64_t x2 __asm__("x2") = 0;
+		register uint64_t x3 __asm__("x3") = 0;
+		__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+		    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+		    "x14", "x15", "x16", "x17", "cc", "memory");
+		IOLog("SWEET: PSCI 0x%llx returned 0x%llx\n", fn, x0);
+	}
+#endif
+	return IODTPlatformExpert::haltRestart(type);
+}
