diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..553845d 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -222,6 +222,130 @@ pe_init_fiq()
 	__builtin_arm_isb(ISB_SY);
 #endif /* SWEET */
 }
+#elif SWEET_GICV2
+/*
+ * Raspberry Pi 5 GIC-400 (GICv2). No ICC_* system registers: the CPU
+ * interface (GICC) is memory mapped. TF-A runs the GIC with security
+ * extensions, so from EL1 non-secure everything we can see is Group 1 and
+ * arrives as an IRQ (sleh_irq). Sequence verified on hardware by shim-pi5:
+ * GICD_CTLR bit 0, priority 0xA0, GICC_PMR 0xF0, GICC_CTLR bit 0.
+ *
+ * ADT /arm-io/gic "reg" = <GICD base, GICD size, GICC base, GICC size>,
+ * arm-io relative, same shape as the GICv3 node (GICR replaced by GICC).
+ */
+SECURITY_READ_ONLY_LATE(uint32_t) sweet_vtimer_intid = SWEET_VTIMER_INTID;
+
+static vm_offset_t gicd_base;
+static vm_offset_t gicc_base;
+/* GIC CPU-interface target mask of each logical CPU, for GICD_SGIR. */
+static uint8_t gic_cpu_mask[SWEET_SMP_MAX_CPUS];
+
+static inline uint32_t
+gic_read32(vm_offset_t addr)
+{
+	return *((volatile uint32_t *) addr);
+}
+
+static inline void
+gic_write32(vm_offset_t addr, uint32_t value)
+{
+	*((volatile uint32_t *) addr) = value;
+}
+
+void
+pe_init_fiq()
+{
+	int error;
+	DTEntry entry;
+
+	if (!gicd_base) {
+		error = SecureDTLookupEntry(NULL, "/arm-io/gic", &entry);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC node in DT", __func__);
+		}
+		void const *prop;
+		unsigned int prop_size;
+		error = SecureDTGetProperty(entry, "reg", &prop, &prop_size);
+		if (error != kSuccess || prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: GIC reg must be <GICD size GICC size>, got %u bytes", __func__,
+			    error == kSuccess ? prop_size : 0);
+		}
+		void const *timer_prop;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess &&
+		    timer_size == sizeof(uint32_t)) {
+			uint32_t intid = *(const uint32_t *)timer_prop;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			sweet_vtimer_intid = intid;
+		}
+
+		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+		uint64_t const *reg = (uint64_t const *)prop;
+		gicd_base = ml_io_map(soc_base_phys + reg[0], reg[1]);
+		gicc_base = ml_io_map(soc_base_phys + reg[2], reg[3]);
+		if (!gicd_base || !gicc_base) {
+			panic("%s: cannot map GICD/GICC", __func__);
+		}
+		kprintf("SWEET GIC: GICv2 GICD 0x%llx GICC 0x%llx, virtual timer INTID %u\n",
+		    (uint64_t)(soc_base_phys + reg[0]), (uint64_t)(soc_base_phys + reg[2]),
+		    sweet_vtimer_intid);
+
+		/* Distributor: non-secure view, bit 0 = EnableGrp1. */
+		gic_write32(gicd_base + GICD_CTLR_V2, gic_read32(gicd_base + GICD_CTLR_V2) | 1);
+	}
+
+	/*
+	 * Per CPU. GICD_ITARGETSR0-7 are banked: byte 0 reads back this CPU's
+	 * own interface mask, which GICD_SGIR needs to reach it.
+	 */
+	unsigned int cpu = ml_get_cpu_number_local();
+	uint8_t mask = (uint8_t)(gic_read32(gicd_base + GICD_ITARGETSR) & 0xff);
+	if (cpu < SWEET_SMP_MAX_CPUS) {
+		gic_cpu_mask[cpu] = mask;
+	}
+
+	/* SGIs and PPIs (banked): priority, then enable timer and IPI SGI. */
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gic_write32(gicd_base + GICD_IPRIORITYR + i, 0xA0A0A0A0);
+	}
+	gic_write32(gicd_base + GICD_ISENABLER, (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+
+	/* CPU interface: accept priority < 0xF0, no preemption grouping, EOImode 0. */
+	gic_write32(gicc_base + GICC_PMR, 0xF0);
+	gic_write32(gicc_base + GICC_BPR, 0);
+	gic_write32(gicc_base + GICC_CTLR, 1);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+	kprintf("SWEET GIC: cpu %u interface mask 0x%x\n", cpu, mask);
+}
+
+uint32_t
+sweet_gic_ack(void)
+{
+	return gic_read32(gicc_base + GICC_IAR);
+}
+
+void
+sweet_gic_eoi(uint32_t iar)
+{
+	gic_write32(gicc_base + GICC_EOIR, iar);
+}
+
+void
+sweet_gic_send_sgi(unsigned int cpu, unsigned int sgi)
+{
+	uint8_t mask = cpu < SWEET_SMP_MAX_CPUS ? gic_cpu_mask[cpu] : 0;
+	if (mask == 0) {
+		/* Target has not run pe_init_fiq yet: GIC-400 interface n = core n on BCM2712. */
+		mask = (uint8_t)(1U << cpu);
+	}
+	__builtin_arm_dsb(DSB_ISHST);
+	/* TargetListFilter 0 (use the list), CPUTargetList [23:16], SGIINTID [3:0]. */
+	gic_write32(gicd_base + GICD_SGIR, ((uint32_t)mask << 16) | (sgi & 0xF));
+	__builtin_arm_isb(ISB_SY);
+}
 #else
 void
 pe_init_fiq()
