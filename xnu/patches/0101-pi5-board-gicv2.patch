+/*
+ * SWEET: IOKit presence for kernel network interfaces (Pi 5 iPhone USB
+ * tethering, bsd/dev/sweet_xhci.c).
+ *
+ * configd (InterfaceNamer, PreferencesMonitor, IPMonitor) only manages
+ * interfaces it finds in the IOKit registry as IONetworkInterface objects
+ * under an IONetworkController. IONetworkingFamily is a separate kext on
+ * Apple's systems and is not built here; these minimal classes carry the
+ * same names and the properties configd reads, for an ifnet the driver
+ * created itself ("BSD Name" set, so nothing needs naming).
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSString.h>
+
+class IONetworkController : public IOService {
+	OSDeclareDefaultStructors(IONetworkController);
+};
+OSDefineMetaClassAndStructors(IONetworkController, IOService);
+
+class IOEthernetController : public IONetworkController {
+	OSDeclareDefaultStructors(IOEthernetController);
+};
+OSDefineMetaClassAndStructors(IOEthernetController, IONetworkController);
+
+class IONetworkInterface : public IOService {
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class IOEthernetInterface : public IONetworkInterface {
+	OSDeclareDefaultStructors(IOEthernetInterface);
+};
+OSDefineMetaClassAndStructors(IOEthernetInterface, IONetworkInterface);
+
+static IOEthernetController *gSweetNetController;
+static IOEthernetInterface *gSweetNetInterface;
+
+static void
+set_num(IOService *s, const char *key, unsigned long long v, unsigned bits)
+{
+	s->setProperty(key, v, bits);
+}
+
+/*
+ * Register an Ethernet controller + interface pair for the ifnet
+ * prefix<unit> ("en", 1 -> en1) with the given MAC. Once only.
+ */
+extern "C" void
+sweet_net_register(const char *prefix, unsigned unit, const unsigned char mac[6], const char *model)
+{
+	if (gSweetNetInterface) {
+		return;
+	}
+	IOService *res = IOService::getResourceService();
+	IOEthernetController *ctl = OSTypeAlloc(IOEthernetController);
+	IOEthernetInterface *nif = OSTypeAlloc(IOEthernetInterface);
+	if (!res || !ctl || !nif || !ctl->init() || !nif->init()) {
+		IOLog("SWEET NET: registry objects not created\n");
+		OSSafeReleaseNULL(ctl);
+		OSSafeReleaseNULL(nif);
+		return;
+	}
+
+	OSData *macd = OSData::withBytes(mac, 6);
+	ctl->setProperty("IOMACAddress", macd);
+	ctl->setProperty("IOVendor", "Apple");
+	ctl->setProperty("IOModel", model);
+	ctl->setProperty("IORevision", "1");
+	set_num(ctl, "IOLinkStatus", 3, 32);            /* valid | active */
+	set_num(ctl, "IOLinkSpeed", 480000000ULL, 64);
+	set_num(ctl, "IOMaxPacketSize", 1514, 32);
+	set_num(ctl, "IOMinPacketSize", 64, 32);
+	set_num(ctl, "IOFeatures", 0, 32);
+	OSSafeReleaseNULL(macd);
+
+	char bsd[16];
+	snprintf(bsd, sizeof(bsd), "%s%u", prefix, unit);
+	nif->setProperty("BSD Name", bsd);
+	nif->setProperty("IOInterfaceNamePrefix", prefix);
+	nif->setProperty("IOInterfaceName", prefix);
+	set_num(nif, "IOInterfaceUnit", unit, 32);
+	set_num(nif, "IOInterfaceType", 6, 32);         /* IFT_ETHER */
+	set_num(nif, "IOMediaAddressLength", 6, 32);
+	set_num(nif, "IOMediaHeaderLength", 14, 32);
+	set_num(nif, "IOMaxTransferUnit", 1500, 32);
+	set_num(nif, "IOInterfaceFlags", 0x8863, 32);
+	set_num(nif, "IOInterfaceState", 3, 32);
+	nif->setProperty("IOBuiltin", false);
+	nif->setProperty("IOPrimaryInterface", false);
+	nif->setProperty("IOLocation", "USB");
+
+	if (!ctl->attach(res)) {
+		IOLog("SWEET NET: controller attach failed\n");
+		ctl->release();
+		nif->release();
+		return;
+	}
+	ctl->registerService();
+	if (!nif->attach(ctl)) {
+		IOLog("SWEET NET: interface attach failed\n");
+		nif->release();
+		return;
+	}
+	nif->registerService();
+	gSweetNetController = ctl;
+	gSweetNetInterface = nif;
+	IOLog("SWEET NET: %s registered (IOEthernetInterface under IOEthernetController, %s)\n", bsd, model);
+}
+
+/* Link up/down as configd's KernelEventMonitor and SCNetworkInterface see it. */
+extern "C" void
+sweet_net_link(int up)
+{
+	if (gSweetNetController) {
+		gSweetNetController->setProperty("IOLinkStatus", up ? 3ULL : 1ULL, 32);
+	}
+}
