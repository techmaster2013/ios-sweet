+	const tt_entry_t want = block_pa | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+#if SWEET_BOARD_PI5
+	/* Called twice on Pi 5 (see sweet_early_map_retry): may already be ours. */
+	assert(*slot == ARM_TTE_EMPTY || *slot == want);
+#else
+	assert(*slot == ARM_TTE_EMPTY);
+#endif
+	*slot = want;
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
+
+#if SWEET_BOARD_PI5
+/*
+ * Real Pi 5 (8ffdc02): after the TTBR1 switch, AT S1E1W on the framebuffer
+ * VA gave a level 2 translation fault although sweet_early_map_final wrote
+ * the block entry (QEMU translates). The early console paused at stage 8c.
+ * Now cpu_tte points at the final tables through the final physmap: write
+ * the entry again, make it visible to the table walker, flush the TLB and
+ * let the console re-check. Reports what the slot held before the rewrite.
+ */
+static void
+sweet_early_map_retry(void)
+{
+	if (!sweet_early_suspended()) {
+		return;
+	}
+	const vm_map_address_t va = SWEET_EARLY_FB_VA;
+	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	if ((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) != (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+		sweet_early_resume(l1, 0, 0);   /* AT will fault: console off */
+		return;
+	}
+	tt_entry_t *slot = &((tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK))[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+	tt_entry_t before = *slot;
+	if (before != ARM_TTE_EMPTY && (before & ARM_TTE_TYPE_MASK) != ARM_TTE_TYPE_BLOCK) {
+		sweet_early_resume(l1, before, before);  /* something else lives here: leave it */
+		return;
+	}
+	sweet_early_map_final();
+	__asm__ volatile("dsb ish" ::: "memory");
+	flush_mmu_tlb();
+	__builtin_arm_isb(ISB_SY);
+	sweet_early_resume(l1, before, *slot);
+}
+#endif
 #endif
 
